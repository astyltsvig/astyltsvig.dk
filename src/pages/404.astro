---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { notfound } from '~/copy/notfound';

const da = notfound.da;
const en = notfound.en;
---
<BaseLayout lang="da" title={da.meta.title} description={da.meta.description} noindex={true}>
  <section class="mx-auto max-w-6xl px-6 md:px-10 pt-24 md:pt-36 pb-24">
    <p class="font-mono text-sm text-muted">{da.code}</p>
    <h1 class="mt-4 text-[clamp(2.25rem,5.5vw,4rem)]">{da.heading}</h1>
    <p class="mt-5 text-muted">{da.text} <span lang="en">{en.heading} {en.text}</span></p>
    <div class="mt-10 flex flex-wrap gap-8">
      <a href="/" class="text-accent underline underline-offset-4 decoration-1 hover:text-accent-strong transition-colors duration-150">
        {da.homeLink}
      </a>
      <a href="/en/" lang="en" class="text-accent underline underline-offset-4 decoration-1 hover:text-accent-strong transition-colors duration-150">
        {en.homeLink}
      </a>
    </div>
  </section>
</BaseLayout>
