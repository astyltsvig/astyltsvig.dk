---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ShimmerCTA from '~/components/ShimmerCTA.astro';
import { routes, t } from '~/i18n/utils';
import { breadcrumbList, webPage, SITE_URL } from '~/lib/seo';
const lang = 'da' as const;
const d = t(lang);

const services = [
  {
    title: 'Enterprise-platformudvikling',
    lede: 'Systemer formet efter din forretning — booking, ERP og CRM. Tre er i daglig produktion i dag; den ældste har kørt siden 2022. Foretrukket stack er Laravel og Vue, altid tilpasset opgaven.',
    stack: 'Foretrukket: Laravel · Vue',
    items: [
      'Nye platforme — fra arkitektur til produktion',
      'Langsigtet drift: hosting, deploys og support',
      'Videreudvikling og optimering af eksisterende kodebaser',
      'Integrationer: betaling, regnskab, kalender og identitet',
    ],
  },
  {
    title: 'Hjemmesider & CMS-migration',
    lede: 'Fra tungt WordPress til hurtige, statiske sites — med indhold og URL-struktur intakt. Som udgangspunkt Astro med headless CMS.',
    stack: 'Astro · Sveltia · Decap · Cloudflare Pages',
    items: [
      'WordPress → Astro/Sveltia med bevaret indhold og URL-struktur',
      'Nye sites bygget fra bunden',
      'Drift på Cloudflare Pages — ofte gratis i drift',
      'Redaktøroplæring og dokumentation',
    ],
  },
  {
    title: 'Infrastruktur & drift',
    lede: 'Fundamentet der bare skal virke — DNS, email og servere. Migreringer gennemføres uden afbrydelser.',
    stack: 'Hetzner · Cloudflare · SPF/DKIM/DMARC · Google Workspace',
    items: [
      'DNS-flytning mellem udbydere — uden email-nedbrud',
      'SPF, DKIM og DMARC sat rigtigt op',
      'Google Workspace-administration og brugerstyring',
      'Serverdrift på Hetzner med backup',
    ],
  },
  {
    title: 'Teknisk rådgivning',
    lede: 'En teknisk sparringspartner når beslutningen er stor, og der ikke er en CTO i huset.',
    stack: 'Strategi · Arkitektur · Review',
    items: [
      'Vurdering af systemer og leverandøraftaler',
      'Arkitektur- og stackvalg før et udbud',
      'Code review og sikkerhedsgennemgang',
    ],
  },
];
const description = 'AStyltsvig Consulting leverer enterprise-platformudvikling i Laravel og Vue, hjemmesider og CMS-migration, samt DNS- og email-infrastruktur og teknisk rådgivning.';
const jsonLd = [
  webPage({ lang, path: '/ydelser', name: 'Ydelser — AStyltsvig Consulting', description }),
  breadcrumbList([
    { name: 'Forside', path: '/' },
    { name: 'Ydelser', path: '/ydelser' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.title,
        description: s.lede,
        provider: { '@id': `${SITE_URL}/#consulting` },
        areaServed: ['DK', 'EU', 'Worldwide'],
      },
    })),
  },
];
---
<BaseLayout
  lang={lang}
  title="Ydelser — AStyltsvig Consulting (Laravel, Vue, enterprise-platforme)"
  description={description}
  jsonLd={jsonLd}
>
  <article class="max-w-6xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-16">
    <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">Ydelser</p>
    <h1 class="fade-in !mt-4 max-w-[22ch]">
      Fire områder. <span class="grad-text">Én hovedopgave</span>.
    </h1>
    <p class="fade-in mt-8 max-w-[60ch] text-lg text-[var(--color-muted)]">
      Alt starter i dit behov — ikke i en standardpakke. Platformudvikling og -drift er kerneopgaven; resten løses efter behov, som løbende aftale eller fast estimat.
    </p>

    <div class="mt-16 grid gap-6">
      {services.map((s, i) => (
        <div class="fade-in glass p-7 md:p-10" style={`transition-delay: ${i * 60}ms`}>
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="!mt-0 text-3xl md:text-4xl">{s.title}</h2>
            <span class="chip">{s.stack}</span>
          </div>
          <p class="mt-5 text-[var(--color-muted)] max-w-[64ch]">{s.lede}</p>
          <ul class="mt-6 grid gap-2 md:grid-cols-2 text-sm">
            {s.items.map(item => (
              <li class="flex gap-2.5">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-none"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-20 fade-in flex justify-center">
      <ShimmerCTA href={routes.contact[lang]} variant="primary">{d.cta.writeToMe}</ShimmerCTA>
    </div>
  </article>
</BaseLayout>
