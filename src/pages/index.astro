---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CaseCard from '~/components/CaseCard.astro';
import ShimmerCTA from '~/components/ShimmerCTA.astro';
import CaseIcon from '~/components/CaseIcon.astro';
import { getCollection } from 'astro:content';
import { t, routes } from '~/i18n/utils';

const lang = 'da' as const;
const d = t(lang);
const cases = (await getCollection('casesDa')).sort((a, b) => a.data.order - b.data.order);
const featuredSlugs = ['ddl-tegnsprogspakken', 'festival-sans-pression', 'book2go', 'df1866'];
const featured = featuredSlugs
  .map(slug => cases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);

const stackStrip = [
  'Vue', 'Laravel', 'Astro', 'PHP', 'TypeScript', 'MySQL', 'PostgreSQL',
  'Hetzner', 'Cloudflare', 'Google Workspace', 'SPF · DKIM · DMARC', 'Sveltia CMS',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://astyltsvig.dk/#andreas',
      name: 'Andreas Sørbye Styltsvig',
      givenName: 'Andreas',
      additionalName: 'Sørbye',
      familyName: 'Styltsvig',
      alternateName: ['Andreas Styltsvig', 'A. Styltsvig', 'Styltsvig'],
      jobTitle: 'IT-konsulent & softwarearkitekt',
      description: 'IT-konsulent og softwarearkitekt i København — designer, bygger og drifter enterprise-grade platforme som organisationer driver forretning på. Foretrukket stack: Laravel og Vue, men altid tilpasset opgaven.',
      url: 'https://astyltsvig.dk/',
      mainEntityOfPage: 'https://astyltsvig.dk/om',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'København',
        addressCountry: 'DK',
      },
      nationality: 'DK',
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Cphbusiness Lyngby (Copenhagen Business Academy)',
        url: 'https://www.cphbusiness.dk/',
      },
      knowsAbout: [
        'Vue.js', 'Laravel', 'Fullstack-udvikling', 'Enterprise-platformudvikling',
        'ERP-systemer', 'Bookingplatforme', 'CRM-platforme',
        'TypeScript', 'PHP', 'MySQL', 'PostgreSQL',
        'DNS', 'SPF', 'DKIM', 'DMARC', 'Google Workspace', 'Hetzner', 'Cloudflare Pages',
      ],
      knowsLanguage: ['da', 'en'],
      worksFor: { '@id': 'https://astyltsvig.dk/#consulting' },
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': ['ProfessionalService', 'Organization'],
      '@id': 'https://astyltsvig.dk/#consulting',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'AStyltsvig ApS', 'Styltsvig Consulting'],
      legalName: 'AStyltsvig Consulting',
      description: 'IT-konsulentvirksomhed i København specialiseret i enterprise-platformudvikling i Vue og Laravel — ERP-systemer, bookingplatforme og CRM.',
      url: 'https://astyltsvig.dk',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      logo: {
        '@type': 'ImageObject',
        url: 'https://astyltsvig.dk/logo.png',
        width: 560,
        height: 120,
      },
      founder: { '@id': 'https://astyltsvig.dk/#andreas' },
      employee: { '@id': 'https://astyltsvig.dk/#andreas' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'København',
        addressCountry: 'DK',
      },
      areaServed: ['DK', 'EU', 'Worldwide'],
      knowsLanguage: ['da', 'en'],
      priceRange: '$$$',
      identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: '36163771' },
      taxID: '36163771',
      vatID: 'DK36163771',
      foundingDate: '2020',
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://astyltsvig.dk/#website',
      url: 'https://astyltsvig.dk',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'astyltsvig.dk'],
      description: 'Andreas Sørbye Styltsvig — IT-konsulent og softwarearkitekt der bygger enterprise-grade platforme i København. Leverer end-to-end fra arkitektur til drift, foretrukket i Laravel og Vue.',
      publisher: { '@id': 'https://astyltsvig.dk/#consulting' },
      inLanguage: ['da', 'en'],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://astyltsvig.dk/#webpage',
      url: 'https://astyltsvig.dk/',
      name: 'AStyltsvig Consulting — Andreas Sørbye Styltsvig',
      isPartOf: { '@id': 'https://astyltsvig.dk/#website' },
      about: { '@id': 'https://astyltsvig.dk/#consulting' },
      mainEntity: { '@id': 'https://astyltsvig.dk/#consulting' },
      primaryImageOfPage: 'https://astyltsvig.dk/og-default.png',
      inLanguage: 'da',
    },
  ],
};
---
<BaseLayout
  lang={lang}
  title="Andreas Sørbye Styltsvig — IT-konsulent & softwarearkitekt, AStyltsvig Consulting København"
  description="Andreas Sørbye Styltsvig driver AStyltsvig Consulting i København. IT-konsulent og softwarearkitekt der bygger enterprise-platforme som organisationer driver forretning på — Book2Go, Mallard ERP og CRM til SecureLife/Care Pensions i daglig produktion. Foretrukket stack Laravel og Vue, altid tilpasset opgaven."
  jsonLd={jsonLd}
>
  <!-- Hero: short and quiet -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-12">
    <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">
      Andreas Sørbye Styltsvig · AStyltsvig Consulting · København
    </p>
    <h1 class="fade-in !mt-3 max-w-[22ch]">
      Enterprise-platforme der <span class="grad-text">driver forretning</span>.
    </h1>
    <p class="fade-in mt-5 max-w-[54ch] text-[var(--color-muted)] leading-relaxed">
      IT-konsulent &amp; softwarearkitekt. Jeg designer, bygger og drifter booking-, ERP- og CRM-platforme — som én udvikler, med AI som en integreret del af arbejdet.
    </p>
    <div class="fade-in mt-7 flex flex-wrap gap-3">
      <ShimmerCTA href={routes.work[lang]} variant="primary">{d.cta.seeMyWork}</ShimmerCTA>
      <ShimmerCTA href={routes.contact[lang]}>{d.cta.getInTouch}</ShimmerCTA>
    </div>
  </section>

  <!-- Stats band -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-subtle)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-8 md:py-10 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6">
      <div class="fade-in">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">3</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Platforme i daglig produktion</p>
      </div>
      <div class="fade-in" style="transition-delay: 60ms">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">10+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">År med IT og webudvikling</p>
      </div>
      <div class="fade-in" style="transition-delay: 120ms">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">2020</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Selvstændig siden</p>
      </div>
      <div class="fade-in" style="transition-delay: 180ms">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">1.000+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Slutbrugere betjent dagligt</p>
      </div>
    </div>
  </section>

  <!-- Featured work: image-first 2x2 -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.selectedWork}</p>
        <h2 class="fade-in !mt-3 max-w-[24ch]">Seneste <span class="grad-text">engagementer</span>.</h2>
      </div>
      <a href={routes.work[lang]} class="fade-in text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)]">{d.cta.seeMyWork} →</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {featured.map((c, i) => (
        <CaseCard
          lang={lang}
          slug={c.slug}
          client={c.data.client}
          headline={c.data.headline}
          stack={c.data.stack}
          screenshot={c.data.screenshot}
          screenshotAlt={c.data.screenshotAlt}
          icon={c.data.icon}
          index={i}
        />
      ))}
    </div>
  </section>

  <!-- Focus areas: icon columns, one line each -->
  <section class="border-t border-[var(--color-rule)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-12 md:py-16">
      <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.whatIDo}</p>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        <div class="fade-in">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-rule)] bg-[var(--color-bg-subtle)] text-[var(--color-accent)]">
            <CaseIcon name="chart" class="h-5 w-5" />
          </span>
          <h3 class="!mt-3">Enterprise-platforme</h3>
          <p class="mt-1.5 text-sm text-[var(--color-muted)]">Booking, ERP og CRM — arkitektur, udvikling og drift i Laravel og Vue.</p>
        </div>
        <div class="fade-in" style="transition-delay: 60ms">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-rule)] bg-[var(--color-bg-subtle)] text-[var(--color-accent)]">
            <CaseIcon name="code" class="h-5 w-5" />
          </span>
          <h3 class="!mt-3">Hjemmesider &amp; CMS</h3>
          <p class="mt-1.5 text-sm text-[var(--color-muted)]">Astro og headless CMS — hurtige sites og arbejdsgange der fungerer.</p>
        </div>
        <div class="fade-in" style="transition-delay: 120ms">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-rule)] bg-[var(--color-bg-subtle)] text-[var(--color-accent)]">
            <CaseIcon name="globe" class="h-5 w-5" />
          </span>
          <h3 class="!mt-3">Infrastruktur</h3>
          <p class="mt-1.5 text-sm text-[var(--color-muted)]">DNS, email-autentificering og serverdrift — leverandørskift uden afbrydelser.</p>
        </div>
      </div>
      <div class="fade-in mt-10 flex flex-wrap gap-2">
        {stackStrip.map(s => <span class="chip">{s}</span>)}
      </div>
    </div>
  </section>

  <!-- Principles: four one-liners -->
  <section class="border-t border-[var(--color-rule)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-12 md:py-16">
      <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">Det du kan regne med</p>
      <div class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="fade-in">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">01</p>
          <h3 class="!mt-1.5 text-base font-medium font-[var(--font-sans)]">Du ejer koden</h3>
          <p class="mt-1 text-sm text-[var(--color-muted)]">Alt i dit repo, på dit domæne.</p>
        </div>
        <div class="fade-in" style="transition-delay: 60ms">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">02</p>
          <h3 class="!mt-1.5 text-base font-medium font-[var(--font-sans)]">Én fast ansvarsperson</h3>
          <p class="mt-1 text-sm text-[var(--color-muted)]">Samme person i dag og om tre år.</p>
        </div>
        <div class="fade-in" style="transition-delay: 120ms">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">03</p>
          <h3 class="!mt-1.5 text-base font-medium font-[var(--font-sans)]">Løbende aftaler</h3>
          <p class="mt-1 text-sm text-[var(--color-muted)]">Frem for fastpris — stop når som helst.</p>
        </div>
        <div class="fade-in" style="transition-delay: 180ms">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">04</p>
          <h3 class="!mt-1.5 text-base font-medium font-[var(--font-sans)]">Direkte linje</h3>
          <p class="mt-1 text-sm text-[var(--color-muted)]">Mail, telefon eller Slack — ingen ticketsystem.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="fade-in glass glass-strong p-8 md:p-10 md:flex items-center justify-between gap-10">
      <div>
        <h2 class="!mt-0">Har du et <span class="grad-text">projekt?</span></h2>
        <p class="mt-3 max-w-[52ch] text-sm text-[var(--color-muted)]">
          Jeg tager løbende nye kunder ind. Send en kort beskrivelse af opgaven — jeg svarer inden for to hverdage.
        </p>
      </div>
      <div class="mt-6 md:mt-0 flex-none">
        <ShimmerCTA href={routes.contact[lang]} variant="primary">{d.cta.writeToMe}</ShimmerCTA>
      </div>
    </div>
  </section>
</BaseLayout>
