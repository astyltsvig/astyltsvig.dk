---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CaseCard from '~/components/CaseCard.astro';
import ShimmerCTA from '~/components/ShimmerCTA.astro';
import CaseIcon from '~/components/CaseIcon.astro';
import { Image } from 'astro:assets';
import heroShotMain from '~/assets/cases/tegnsprogspakken.png';
import heroShotSmall from '~/assets/cases/df1866.png';
import portrait from '~/assets/andreas-styltsvig.png';
import { getCollection } from 'astro:content';
import { t, routes, caseUrl } from '~/i18n/utils';

const lang = 'da' as const;
const d = t(lang);
const cases = (await getCollection('casesDa')).sort((a, b) => a.data.order - b.data.order);
const featuredSlugs = ['ddl-tegnsprogspakken', 'festival-sans-pression', 'book2go', 'df1866'];
const featured = featuredSlugs
  .map(slug => cases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);

const stackStrip = [
  'Vue', 'Laravel', 'Astro', 'PHP', 'TypeScript', 'MySQL', 'PostgreSQL',
  'Hetzner', 'Cloudflare', 'Google Workspace', 'SPF · DKIM · DMARC', 'Sveltia CMS',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://astyltsvig.dk/#andreas',
      name: 'Andreas Sørbye Styltsvig',
      givenName: 'Andreas',
      additionalName: 'Sørbye',
      familyName: 'Styltsvig',
      alternateName: ['Andreas Styltsvig', 'A. Styltsvig', 'Styltsvig'],
      jobTitle: 'IT-konsulent & softwarearkitekt',
      description: 'IT-konsulent og softwarearkitekt i København — designer, bygger og drifter enterprise-grade platforme som organisationer driver forretning på. Foretrukket stack: Laravel og Vue, men altid tilpasset opgaven.',
      url: 'https://astyltsvig.dk/',
      mainEntityOfPage: 'https://astyltsvig.dk/om',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'København',
        addressCountry: 'DK',
      },
      nationality: 'DK',
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Cphbusiness Lyngby (Copenhagen Business Academy)',
        url: 'https://www.cphbusiness.dk/',
      },
      knowsAbout: [
        'Vue.js', 'Laravel', 'Fullstack-udvikling', 'Enterprise-platformudvikling',
        'ERP-systemer', 'Bookingplatforme', 'CRM-platforme',
        'TypeScript', 'PHP', 'MySQL', 'PostgreSQL',
        'DNS', 'SPF', 'DKIM', 'DMARC', 'Google Workspace', 'Hetzner', 'Cloudflare Pages',
      ],
      knowsLanguage: ['da', 'en'],
      worksFor: { '@id': 'https://astyltsvig.dk/#consulting' },
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': ['ProfessionalService', 'Organization'],
      '@id': 'https://astyltsvig.dk/#consulting',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'AStyltsvig ApS', 'Styltsvig Consulting'],
      legalName: 'AStyltsvig Consulting',
      description: 'IT-konsulentvirksomhed i København specialiseret i enterprise-platformudvikling i Vue og Laravel — ERP-systemer, bookingplatforme og CRM.',
      url: 'https://astyltsvig.dk',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      logo: {
        '@type': 'ImageObject',
        url: 'https://astyltsvig.dk/logo.png',
        width: 560,
        height: 120,
      },
      founder: { '@id': 'https://astyltsvig.dk/#andreas' },
      employee: { '@id': 'https://astyltsvig.dk/#andreas' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'København',
        addressCountry: 'DK',
      },
      areaServed: ['DK', 'EU', 'Worldwide'],
      knowsLanguage: ['da', 'en'],
      priceRange: '$$$',
      identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: '36163771' },
      taxID: '36163771',
      vatID: 'DK36163771',
      foundingDate: '2020',
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://astyltsvig.dk/#website',
      url: 'https://astyltsvig.dk',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'astyltsvig.dk'],
      description: 'Andreas Sørbye Styltsvig — IT-konsulent og softwarearkitekt der bygger enterprise-grade platforme i København. Leverer end-to-end fra arkitektur til drift, foretrukket i Laravel og Vue.',
      publisher: { '@id': 'https://astyltsvig.dk/#consulting' },
      inLanguage: ['da', 'en'],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://astyltsvig.dk/#webpage',
      url: 'https://astyltsvig.dk/',
      name: 'AStyltsvig Consulting — Andreas Sørbye Styltsvig',
      isPartOf: { '@id': 'https://astyltsvig.dk/#website' },
      about: { '@id': 'https://astyltsvig.dk/#consulting' },
      mainEntity: { '@id': 'https://astyltsvig.dk/#consulting' },
      primaryImageOfPage: 'https://astyltsvig.dk/og-default.png',
      inLanguage: 'da',
    },
  ],
};
---
<BaseLayout
  lang={lang}
  title="Andreas Sørbye Styltsvig — IT-konsulent & softwarearkitekt, AStyltsvig Consulting København"
  description="Andreas Sørbye Styltsvig driver AStyltsvig Consulting i København. IT-konsulent og softwarearkitekt der bygger enterprise-platforme som organisationer driver forretning på — Book2Go, Mallard ERP og CRM til SecureLife/Care Pensions i daglig produktion. Foretrukket stack Laravel og Vue, altid tilpasset opgaven."
  jsonLd={jsonLd}
>
  <!-- Hero: short text left, work collage right -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-14 md:pb-20">
    <div class="grid md:grid-cols-[1.15fr_1fr] gap-12 md:gap-16 items-center">
      <div>
        <p class="fade-in"><span class="badge"><span class="dot"></span>3 platforme i daglig produktion</span></p>
        <h1 class="fade-in !mt-5 max-w-[20ch]">
          Digitale platforme, bygget til at <span class="grad-text">drive din forretning</span>.
        </h1>
        <p class="fade-in mt-5 max-w-[54ch] text-[var(--color-muted)] leading-relaxed">
          IT-konsulent &amp; softwarearkitekt. Rådgivning og udvikling formet efter din forretning — booking, ERP og CRM, bygget og driftet af én udvikler med AI som en integreret del af arbejdet.
        </p>
        <div class="fade-in mt-7 flex flex-wrap gap-3">
          <ShimmerCTA href={routes.work[lang]} variant="primary">{d.cta.seeMyWork}</ShimmerCTA>
          <ShimmerCTA href={routes.contact[lang]}>{d.cta.getInTouch}</ShimmerCTA>
        </div>
      </div>
      <div class="fade-in relative hidden md:block pb-10 pl-10" style="transition-delay: 120ms" aria-hidden="true">
        <div class="overflow-hidden rounded-xl border border-[var(--color-rule)] shadow-[0_24px_60px_-32px_rgba(15,16,20,0.35)]">
          <Image
            src={heroShotMain}
            alt=""
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 40vw, 0px"
            class="aspect-[4/3] w-full object-cover object-top"
          />
        </div>
        <div class="absolute bottom-0 left-0 w-[52%] overflow-hidden rounded-lg border border-[var(--color-rule)] bg-[var(--color-bg)] shadow-[0_18px_44px_-26px_rgba(15,16,20,0.4)]">
          <Image
            src={heroShotSmall}
            alt=""
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 22vw, 0px"
            class="aspect-[16/10] w-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-subtle)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-8 md:py-10 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6">
      <div class="fade-in">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">3</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Platforme i daglig produktion</p>
      </div>
      <div class="fade-in" style="transition-delay: 60ms">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">10+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">År med IT og webudvikling</p>
      </div>
      <div class="fade-in" style="transition-delay: 120ms">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">2020</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Selvstændig siden</p>
      </div>
      <div class="fade-in" style="transition-delay: 180ms">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">1.000+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Slutbrugere betjent dagligt</p>
      </div>
    </div>
  </section>

  <!-- Featured work: image-first 2x2 -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.selectedWork}</p>
        <h2 class="fade-in !mt-3 max-w-[24ch]">Seneste <span class="grad-text">engagementer</span>.</h2>
      </div>
      <a href={routes.work[lang]} class="fade-in text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)]">{d.cta.seeMyWork} →</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {featured.map((c, i) => (
        <CaseCard
          lang={lang}
          slug={c.slug}
          client={c.data.client}
          headline={c.data.headline}
          stack={c.data.stack}
          screenshot={c.data.screenshot}
          screenshotAlt={c.data.screenshotAlt}
          icon={c.data.icon}
          index={i}
        />
      ))}
    </div>
  </section>

  <!-- Competencies: tile grid -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.whatIDo}</p>
        <h2 class="fade-in !mt-3 max-w-[28ch]">Bygget til jeres behov — <span class="grad-text">bevist i produktion</span>.</h2>
      </div>
      <a href={routes.services[lang]} class="fade-in text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)]">Se alle ydelser →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href={caseUrl(lang, 'mallard')} class="fade-in glass card-link flex flex-col p-5">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">ERP &amp; forretningssystemer</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Skræddersyede systemer der bærer den daglige drift — som Mallards ERP siden 2022.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
      <a href={caseUrl(lang, 'book2go')} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 60ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Booking &amp; realtidsplatforme</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Flersprogede bookingflows i realtid — som Book2Go for Cycling Without Age.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
      <a href={caseUrl(lang, 'securelife')} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 120ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">CRM &amp; administration</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Ordninger for hundredvis af virksomheder — som SecureLifes platform.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
      <a href={routes.about[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 180ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">AI-assisteret udvikling<span class="ml-2 inline-flex items-center rounded-full bg-[var(--color-accent)] px-2 py-0.5 text-[9px] font-[var(--font-mono)] uppercase tracking-[0.12em] text-white align-middle">I daglig brug</span></h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">AI er en integreret del af det daglige arbejde — brugt åbent og transparent.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Web &amp; CMS</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Hurtige, statiske sites med redaktørvenligt CMS — Astro og Sveltia.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 60ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">WordPress-migrering</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Fra tungt WordPress til moderne stack — uden at miste indhold eller URL’er.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 120ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Infrastruktur &amp; DNS</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">DNS, email-autentificering og serverdrift — flytninger uden nedbrud.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 180ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Teknisk rådgivning</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Sparring om arkitektur og leverandørvalg — når der ikke er en CTO i huset.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Læs mere →</span>
      </a>
    </div>
  </section>

  <!-- Principles: statement + line list -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-subtle)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20 grid md:grid-cols-[1fr_1.4fr] gap-10 md:gap-20 items-center">
      <div class="fade-in">
        <p class="font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">Det du kan regne med</p>
        <h2 class="!mt-3 max-w-[18ch]">Derfor bliver kunderne <span class="grad-text">i årevis</span>.</h2>
        <p class="mt-4 max-w-[38ch] text-sm text-[var(--color-muted)] leading-relaxed">
          Samarbejdet er bygget til at holde — de fleste af mine kunderelationer løber i år, ikke måneder.
        </p>
      </div>
      <ul class="fade-in border-t border-[var(--color-rule)]" style="transition-delay: 80ms">
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">01</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">Koden er din fra dag ét.</span> <span class="text-[var(--color-muted)]">Alt ligger i dit repo og på dit domæne — går du, tager du det hele med.</span></p>
        </li>
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">02</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">Du taler med den der har bygget det.</span> <span class="text-[var(--color-muted)]">Ingen mellemled — den der svarer, er den der har skrevet koden.</span></p>
        </li>
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">03</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">Løbende aftaler, ingen binding.</span> <span class="text-[var(--color-muted)]">Jeg bygger det rigtige, ikke kun det aftalte — og du kan stoppe når som helst.</span></p>
        </li>
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">04</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">Svar inden for to hverdage.</span> <span class="text-[var(--color-muted)]">Mail, telefon eller Slack — ingen ticketsystem, ingen kø.</span></p>
        </li>
      </ul>
    </div>
  </section>

  <!-- About teaser -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20">
    <div class="fade-in glass overflow-hidden md:grid md:grid-cols-[auto_1fr] items-center">
      <Image
        src={portrait}
        alt="Portræt af Andreas Sørbye Styltsvig"
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 260px, 100vw"
        class="h-56 w-full md:h-full md:w-64 object-cover object-top"
      />
      <div class="p-7 md:p-10">
        <p class="font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">Manden bag</p>
        <h2 class="!mt-3 max-w-[24ch]">Én udvikler. <span class="grad-text">Dybt fokus.</span></h2>
        <p class="mt-4 max-w-[58ch] text-sm text-[var(--color-muted)] leading-relaxed">
          Jeg hedder Andreas Sørbye Styltsvig og driver AStyltsvig Consulting fra København. Mere end et årti med IT og webudvikling — og en praksis bygget på få, langvarige kunderelationer.
        </p>
        <a href={routes.about[lang]} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-2)]">
          Mød Andreas
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
