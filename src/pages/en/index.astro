---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CaseCard from '~/components/CaseCard.astro';
import ShimmerCTA from '~/components/ShimmerCTA.astro';
import CaseIcon from '~/components/CaseIcon.astro';
import { Image } from 'astro:assets';
import heroShotMain from '~/assets/cases/tegnsprogspakken.png';
import heroShotSmall from '~/assets/cases/df1866.png';
import portrait from '~/assets/andreas-styltsvig.png';
import { getCollection } from 'astro:content';
import { t, routes, caseUrl } from '~/i18n/utils';

const lang = 'en' as const;
const d = t(lang);

const cases = (await getCollection('casesEn')).sort((a, b) => a.data.order - b.data.order);
const featuredSlugs = ['ddl-tegnsprogspakken', 'festival-sans-pression', 'book2go', 'df1866'];
const featured = featuredSlugs
  .map(slug => cases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);

const stackStrip = [
  'Vue', 'Laravel', 'Astro', 'PHP', 'TypeScript', 'MySQL', 'PostgreSQL',
  'Hetzner', 'Cloudflare', 'Google Workspace', 'SPF · DKIM · DMARC', 'Sveltia CMS',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://astyltsvig.dk/#andreas',
      name: 'Andreas Sørbye Styltsvig',
      givenName: 'Andreas',
      additionalName: 'Sørbye',
      familyName: 'Styltsvig',
      alternateName: ['Andreas Styltsvig', 'A. Styltsvig', 'Styltsvig'],
      jobTitle: 'IT consultant & software architect',
      description: 'IT consultant and software architect in Copenhagen — designing, building, and operating enterprise-grade platforms organisations run their business on. Preferred stack: Laravel and Vue, always adapted to the brief.',
      url: 'https://astyltsvig.dk/en/',
      mainEntityOfPage: 'https://astyltsvig.dk/en/about',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'Copenhagen',
        addressCountry: 'DK',
      },
      nationality: 'DK',
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Copenhagen Business Academy (Cphbusiness Lyngby)',
        url: 'https://www.cphbusiness.dk/',
      },
      knowsAbout: [
        'Vue.js', 'Laravel', 'Full-stack development', 'Enterprise platform development',
        'ERP systems', 'Booking platforms', 'CRM platforms',
        'TypeScript', 'PHP', 'MySQL', 'PostgreSQL',
        'DNS', 'SPF', 'DKIM', 'DMARC', 'Google Workspace', 'Hetzner', 'Cloudflare Pages',
      ],
      knowsLanguage: ['da', 'en'],
      worksFor: { '@id': 'https://astyltsvig.dk/#consulting' },
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': ['ProfessionalService', 'Organization'],
      '@id': 'https://astyltsvig.dk/#consulting',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'AStyltsvig ApS', 'Styltsvig Consulting'],
      legalName: 'AStyltsvig Consulting',
      description: 'IT consultancy in Copenhagen specialising in enterprise platform development in Vue and Laravel — ERPs, booking platforms, and CRM systems.',
      url: 'https://astyltsvig.dk',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      logo: {
        '@type': 'ImageObject',
        url: 'https://astyltsvig.dk/logo.png',
        width: 560,
        height: 120,
      },
      founder: { '@id': 'https://astyltsvig.dk/#andreas' },
      employee: { '@id': 'https://astyltsvig.dk/#andreas' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'Copenhagen',
        addressCountry: 'DK',
      },
      areaServed: ['DK', 'EU', 'Worldwide'],
      knowsLanguage: ['da', 'en'],
      priceRange: '$$$',
      identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: '36163771' },
      taxID: '36163771',
      vatID: 'DK36163771',
      foundingDate: '2020',
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://astyltsvig.dk/#website',
      url: 'https://astyltsvig.dk',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'astyltsvig.dk'],
      description: 'Andreas Sørbye Styltsvig — IT consultant & software architect building enterprise-grade platforms in Copenhagen. End-to-end delivery from architecture to operation, preferred in Laravel and Vue.',
      publisher: { '@id': 'https://astyltsvig.dk/#consulting' },
      inLanguage: ['da', 'en'],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://astyltsvig.dk/en/#webpage',
      url: 'https://astyltsvig.dk/en/',
      name: 'AStyltsvig Consulting — Andreas Sørbye Styltsvig',
      isPartOf: { '@id': 'https://astyltsvig.dk/#website' },
      about: { '@id': 'https://astyltsvig.dk/#consulting' },
      mainEntity: { '@id': 'https://astyltsvig.dk/#consulting' },
      primaryImageOfPage: 'https://astyltsvig.dk/og-default.png',
      inLanguage: 'en',
    },
  ],
};
---
<BaseLayout
  lang={lang}
  title="Andreas Sørbye Styltsvig — IT consultant & software architect, AStyltsvig Consulting Copenhagen"
  description="Andreas Sørbye Styltsvig runs AStyltsvig Consulting in Copenhagen. IT consultant and software architect building enterprise-grade platforms that organisations run their business on — Book2Go, Mallard ERP, and a SecureLife/Care Pensions CRM in daily production. Preferred stack Laravel and Vue, always adapted to the brief."
  jsonLd={jsonLd}
>
  <!-- Hero: short text left, work collage right -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-14 md:pb-20">
    <div class="grid md:grid-cols-[1.15fr_1fr] gap-12 md:gap-16 items-center">
      <div>
        <p class="fade-in"><span class="badge"><span class="dot"></span>3 platforms in daily production</span></p>
        <h1 class="fade-in !mt-5 max-w-[20ch]">
          Digital platforms, built to <span class="grad-text">run your business</span>.
        </h1>
        <p class="fade-in mt-5 max-w-[54ch] text-[var(--color-muted)] leading-relaxed">
          IT consultant &amp; software architect. Consultation and development shaped around your business — booking, ERP, and CRM, built and operated by one developer with AI as an integrated part of the workflow.
        </p>
        <div class="fade-in mt-7 flex flex-wrap gap-3">
          <ShimmerCTA href={routes.work[lang]} variant="primary">{d.cta.seeMyWork}</ShimmerCTA>
          <ShimmerCTA href={routes.contact[lang]}>{d.cta.getInTouch}</ShimmerCTA>
        </div>
      </div>
      <div class="fade-in relative hidden md:block pb-10 pl-10" style="transition-delay: 120ms" aria-hidden="true">
        <div class="overflow-hidden rounded-xl border border-[var(--color-rule)] shadow-[0_24px_60px_-32px_rgba(15,16,20,0.35)]">
          <Image
            src={heroShotMain}
            alt=""
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 40vw, 0px"
            class="aspect-[4/3] w-full object-cover object-top"
          />
        </div>
        <div class="absolute bottom-0 left-0 w-[52%] overflow-hidden rounded-lg border border-[var(--color-rule)] bg-[var(--color-bg)] shadow-[0_18px_44px_-26px_rgba(15,16,20,0.4)]">
          <Image
            src={heroShotSmall}
            alt=""
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 22vw, 0px"
            class="aspect-[16/10] w-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-subtle)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-8 md:py-10 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6">
      <div class="fade-in">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">3</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Platforms in daily production</p>
      </div>
      <div class="fade-in" style="transition-delay: 60ms">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">10+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Years in IT and web development</p>
      </div>
      <div class="fade-in" style="transition-delay: 120ms">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">2020</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Independent since</p>
      </div>
      <div class="fade-in" style="transition-delay: 180ms">
        <p class="text-4xl md:text-5xl font-bold tracking-tight leading-none text-[var(--color-accent)]">1,000+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">End users served daily</p>
      </div>
    </div>
  </section>

  <!-- Featured work: image-first 2x2 -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.selectedWork}</p>
        <h2 class="fade-in !mt-3 max-w-[24ch]">Recent <span class="grad-text">engagements</span>.</h2>
      </div>
      <a href={routes.work[lang]} class="fade-in text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)]">{d.cta.seeMyWork} →</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {featured.map((c, i) => (
        <CaseCard
          lang={lang}
          slug={c.slug}
          client={c.data.client}
          headline={c.data.headline}
          stack={c.data.stack}
          screenshot={c.data.screenshot}
          screenshotAlt={c.data.screenshotAlt}
          icon={c.data.icon}
          index={i}
        />
      ))}
    </div>
  </section>

  <!-- Competencies: tile grid -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.whatIDo}</p>
        <h2 class="fade-in !mt-3 max-w-[28ch]">Built for your needs — <span class="grad-text">proven in production</span>.</h2>
      </div>
      <a href={routes.services[lang]} class="fade-in text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)]">See all services →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href={caseUrl(lang, 'mallard')} class="fade-in glass card-link flex flex-col p-5">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">ERP &amp; business systems</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Tailored systems that carry daily operations — like Mallard's ERP since 2022.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
      <a href={caseUrl(lang, 'book2go')} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 60ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Booking &amp; real-time platforms</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Multilingual booking flows in real time — like Book2Go for Cycling Without Age.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
      <a href={caseUrl(lang, 'securelife')} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 120ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">CRM &amp; administration</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Schemes across hundreds of companies — like SecureLife's platform.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
      <a href={routes.about[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 180ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">AI-assisted development<span class="ml-2 inline-flex items-center rounded-full bg-[var(--color-accent)] px-2 py-0.5 text-[9px] font-[var(--font-mono)] uppercase tracking-[0.12em] text-white align-middle">In daily use</span></h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">AI is an integrated part of the daily work — used openly and transparently.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Web &amp; CMS</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Fast, static sites with an editor-friendly CMS — Astro and Sveltia.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 60ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">WordPress migration</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">From heavy WordPress to a modern stack — without losing content or URLs.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 120ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Infrastructure &amp; DNS</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">DNS, email authentication, and server operations — moves without downtime.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
      <a href={routes.services[lang]} class="fade-in glass card-link flex flex-col p-5" style="transition-delay: 180ms">
        <h3 class="!mt-0 text-[15px] font-medium font-[var(--font-sans)]">Technical advisory</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Sparring on architecture and vendor choices — when there is no CTO in the building.</p>
        <span class="mt-auto pt-4 font-[var(--font-mono)] text-[11px] text-[var(--color-accent)]">Read more →</span>
      </a>
    </div>
  </section>

  <!-- Principles: statement + line list -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-subtle)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20 grid md:grid-cols-[1fr_1.4fr] gap-10 md:gap-20 items-center">
      <div class="fade-in">
        <p class="font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">What you can count on</p>
        <h2 class="!mt-3 max-w-[18ch]">Why clients stay <span class="grad-text">for years</span>.</h2>
        <p class="mt-4 max-w-[38ch] text-sm text-[var(--color-muted)] leading-relaxed">
          The engagement is built to last — most of my client relationships run for years, not months.
        </p>
      </div>
      <ul class="fade-in border-t border-[var(--color-rule)]" style="transition-delay: 80ms">
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">01</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">The code is yours from day one.</span> <span class="text-[var(--color-muted)]">Everything lives in your repo and on your domain — if you leave, it all goes with you.</span></p>
        </li>
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">02</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">You talk to the person who built it.</span> <span class="text-[var(--color-muted)]">No middlemen — whoever answers is whoever wrote the code.</span></p>
        </li>
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">03</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">Rolling agreements, no lock-in.</span> <span class="text-[var(--color-muted)]">I build the right thing, not just the agreed thing — and you can stop at any time.</span></p>
        </li>
        <li class="flex items-baseline gap-5 py-5 border-b border-[var(--color-rule)]">
          <span class="font-[var(--font-mono)] text-xs text-[var(--color-accent)] flex-none">04</span>
          <p class="text-sm leading-relaxed"><span class="font-medium">A reply within two business days.</span> <span class="text-[var(--color-muted)]">Email, phone, or Slack — no ticket system, no queue.</span></p>
        </li>
      </ul>
    </div>
  </section>

  <!-- About teaser -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20">
    <div class="fade-in glass overflow-hidden md:grid md:grid-cols-[auto_1fr] items-center">
      <Image
        src={portrait}
        alt="Portrait of Andreas Sørbye Styltsvig"
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 260px, 100vw"
        class="h-56 w-full md:h-full md:w-64 object-cover object-top"
      />
      <div class="p-7 md:p-10">
        <p class="font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">The person behind</p>
        <h2 class="!mt-3 max-w-[24ch]">One developer. <span class="grad-text">Deep focus.</span></h2>
        <p class="mt-4 max-w-[58ch] text-sm text-[var(--color-muted)] leading-relaxed">
          I'm Andreas Sørbye Styltsvig, and I run AStyltsvig Consulting from Copenhagen. More than a decade in IT and web development — and a practice built on a few long-standing client relationships.
        </p>
        <a href={routes.about[lang]} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-2)]">
          Meet Andreas
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
