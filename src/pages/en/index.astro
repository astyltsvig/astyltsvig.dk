---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CaseCard from '~/components/CaseCard.astro';
import ShimmerCTA from '~/components/ShimmerCTA.astro';
import CaseIcon from '~/components/CaseIcon.astro';
import { Image } from 'astro:assets';
import heroShotMain from '~/assets/cases/tegnsprogspakken.png';
import heroShotSmall from '~/assets/cases/df1866.png';
import { getCollection } from 'astro:content';
import { t, routes } from '~/i18n/utils';

const lang = 'en' as const;
const d = t(lang);

const cases = (await getCollection('casesEn')).sort((a, b) => a.data.order - b.data.order);
const featuredSlugs = ['ddl-tegnsprogspakken', 'festival-sans-pression', 'book2go', 'df1866'];
const featured = featuredSlugs
  .map(slug => cases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);

const stackStrip = [
  'Vue', 'Laravel', 'Astro', 'PHP', 'TypeScript', 'MySQL', 'PostgreSQL',
  'Hetzner', 'Cloudflare', 'Google Workspace', 'SPF · DKIM · DMARC', 'Sveltia CMS',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://astyltsvig.dk/#andreas',
      name: 'Andreas Sørbye Styltsvig',
      givenName: 'Andreas',
      additionalName: 'Sørbye',
      familyName: 'Styltsvig',
      alternateName: ['Andreas Styltsvig', 'A. Styltsvig', 'Styltsvig'],
      jobTitle: 'IT consultant & software architect',
      description: 'IT consultant and software architect in Copenhagen — designing, building, and operating enterprise-grade platforms organisations run their business on. Preferred stack: Laravel and Vue, always adapted to the brief.',
      url: 'https://astyltsvig.dk/en/',
      mainEntityOfPage: 'https://astyltsvig.dk/en/about',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'Copenhagen',
        addressCountry: 'DK',
      },
      nationality: 'DK',
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Copenhagen Business Academy (Cphbusiness Lyngby)',
        url: 'https://www.cphbusiness.dk/',
      },
      knowsAbout: [
        'Vue.js', 'Laravel', 'Full-stack development', 'Enterprise platform development',
        'ERP systems', 'Booking platforms', 'CRM platforms',
        'TypeScript', 'PHP', 'MySQL', 'PostgreSQL',
        'DNS', 'SPF', 'DKIM', 'DMARC', 'Google Workspace', 'Hetzner', 'Cloudflare Pages',
      ],
      knowsLanguage: ['da', 'en'],
      worksFor: { '@id': 'https://astyltsvig.dk/#consulting' },
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': ['ProfessionalService', 'Organization'],
      '@id': 'https://astyltsvig.dk/#consulting',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'AStyltsvig ApS', 'Styltsvig Consulting'],
      legalName: 'AStyltsvig Consulting',
      description: 'IT consultancy in Copenhagen specialising in enterprise platform development in Vue and Laravel — ERPs, booking platforms, and CRM systems.',
      url: 'https://astyltsvig.dk',
      email: 'hello@astyltsvig.dk',
      image: 'https://astyltsvig.dk/og-default.png',
      logo: {
        '@type': 'ImageObject',
        url: 'https://astyltsvig.dk/logo.png',
        width: 560,
        height: 120,
      },
      founder: { '@id': 'https://astyltsvig.dk/#andreas' },
      employee: { '@id': 'https://astyltsvig.dk/#andreas' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Vanløse',
        addressRegion: 'Copenhagen',
        addressCountry: 'DK',
      },
      areaServed: ['DK', 'EU', 'Worldwide'],
      knowsLanguage: ['da', 'en'],
      priceRange: '$$$',
      identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: '36163771' },
      taxID: '36163771',
      vatID: 'DK36163771',
      foundingDate: '2020',
      sameAs: [
        'https://github.com/astyltsvig',
        'https://www.linkedin.com/in/astyltsvig/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://astyltsvig.dk/#website',
      url: 'https://astyltsvig.dk',
      name: 'AStyltsvig Consulting',
      alternateName: ['AStyltsvig', 'astyltsvig.dk'],
      description: 'Andreas Sørbye Styltsvig — IT consultant & software architect building enterprise-grade platforms in Copenhagen. End-to-end delivery from architecture to operation, preferred in Laravel and Vue.',
      publisher: { '@id': 'https://astyltsvig.dk/#consulting' },
      inLanguage: ['da', 'en'],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://astyltsvig.dk/en/#webpage',
      url: 'https://astyltsvig.dk/en/',
      name: 'AStyltsvig Consulting — Andreas Sørbye Styltsvig',
      isPartOf: { '@id': 'https://astyltsvig.dk/#website' },
      about: { '@id': 'https://astyltsvig.dk/#consulting' },
      mainEntity: { '@id': 'https://astyltsvig.dk/#consulting' },
      primaryImageOfPage: 'https://astyltsvig.dk/og-default.png',
      inLanguage: 'en',
    },
  ],
};
---
<BaseLayout
  lang={lang}
  title="Andreas Sørbye Styltsvig — IT consultant & software architect, AStyltsvig Consulting Copenhagen"
  description="Andreas Sørbye Styltsvig runs AStyltsvig Consulting in Copenhagen. IT consultant and software architect building enterprise-grade platforms that organisations run their business on — Book2Go, Mallard ERP, and a SecureLife/Care Pensions CRM in daily production. Preferred stack Laravel and Vue, always adapted to the brief."
  jsonLd={jsonLd}
>
  <!-- Hero: short text left, work collage right -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-14 md:pb-20">
    <div class="grid md:grid-cols-[1.15fr_1fr] gap-12 md:gap-16 items-center">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">
          Andreas Sørbye Styltsvig · AStyltsvig Consulting · Copenhagen
        </p>
        <h1 class="fade-in !mt-3 max-w-[22ch]">
          Enterprise platforms that <span class="grad-text">run businesses</span>.
        </h1>
        <p class="fade-in mt-5 max-w-[54ch] text-[var(--color-muted)] leading-relaxed">
          IT consultant &amp; software architect. I design, build, and operate booking, ERP, and CRM platforms — as a single developer, with AI as an integrated part of the workflow.
        </p>
        <div class="fade-in mt-7 flex flex-wrap gap-3">
          <ShimmerCTA href={routes.work[lang]} variant="primary">{d.cta.seeMyWork}</ShimmerCTA>
          <ShimmerCTA href={routes.contact[lang]}>{d.cta.getInTouch}</ShimmerCTA>
        </div>
      </div>
      <div class="fade-in relative hidden md:block pb-10 pl-10" style="transition-delay: 120ms" aria-hidden="true">
        <div class="overflow-hidden rounded-xl border border-[var(--color-rule)] shadow-[0_24px_60px_-32px_rgba(15,16,20,0.35)]">
          <Image
            src={heroShotMain}
            alt=""
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 40vw, 0px"
            class="aspect-[4/3] w-full object-cover object-top"
          />
        </div>
        <div class="absolute bottom-0 left-0 w-[52%] overflow-hidden rounded-lg border border-[var(--color-rule)] bg-[var(--color-bg)] shadow-[0_18px_44px_-26px_rgba(15,16,20,0.4)]">
          <Image
            src={heroShotSmall}
            alt=""
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 22vw, 0px"
            class="aspect-[16/10] w-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-subtle)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-8 md:py-10 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6">
      <div class="fade-in">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">3</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Platforms in daily production</p>
      </div>
      <div class="fade-in" style="transition-delay: 60ms">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">10+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Years in IT and web development</p>
      </div>
      <div class="fade-in" style="transition-delay: 120ms">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">2020</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Independent since</p>
      </div>
      <div class="fade-in" style="transition-delay: 180ms">
        <p class="font-[var(--font-display)] text-4xl md:text-5xl leading-none">1,000+</p>
        <p class="mt-2 font-[var(--font-mono)] text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">End users served daily</p>
      </div>
    </div>
  </section>

  <!-- Featured work: image-first 2x2 -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.selectedWork}</p>
        <h2 class="fade-in !mt-3 max-w-[24ch]">Recent <span class="grad-text">engagements</span>.</h2>
      </div>
      <a href={routes.work[lang]} class="fade-in text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)]">{d.cta.seeMyWork} →</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {featured.map((c, i) => (
        <CaseCard
          lang={lang}
          slug={c.slug}
          client={c.data.client}
          headline={c.data.headline}
          stack={c.data.stack}
          screenshot={c.data.screenshot}
          screenshotAlt={c.data.screenshotAlt}
          icon={c.data.icon}
          index={i}
        />
      ))}
    </div>
  </section>

  <!-- Focus areas: joined grid -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">{d.sections.whatIDo}</p>
        <h2 class="fade-in !mt-3 max-w-[24ch]">Three areas — <span class="grad-text">one supplier</span>.</h2>
      </div>
      <a href={routes.services[lang]} class="fade-in text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)]">See all services →</a>
    </div>
    <div class="fade-in mt-8 grid md:grid-cols-3 gap-px rounded-xl border border-[var(--color-rule)] bg-[var(--color-rule)] overflow-hidden">
      <div class="bg-[var(--color-bg)] p-7">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-bg-subtle)] text-[var(--color-accent)]">
          <CaseIcon name="chart" class="h-5 w-5" />
        </span>
        <h3 class="!mt-4">Enterprise platforms</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">Booking, ERP, and CRM — architecture, development, and operations in one place.</p>
        <div class="mt-5 flex flex-wrap gap-1.5">
          <span class="chip">Laravel</span><span class="chip">Vue</span><span class="chip">MySQL</span><span class="chip">PostgreSQL</span>
        </div>
      </div>
      <div class="bg-[var(--color-bg)] p-7">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-bg-subtle)] text-[var(--color-accent)]">
          <CaseIcon name="code" class="h-5 w-5" />
        </span>
        <h3 class="!mt-4">Websites &amp; CMS</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">New sites and migrations — fast pages and workflows that hold up.</p>
        <div class="mt-5 flex flex-wrap gap-1.5">
          <span class="chip">Astro</span><span class="chip">Sveltia CMS</span><span class="chip">Cloudflare Pages</span>
        </div>
      </div>
      <div class="bg-[var(--color-bg)] p-7">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-bg-subtle)] text-[var(--color-accent)]">
          <CaseIcon name="globe" class="h-5 w-5" />
        </span>
        <h3 class="!mt-4">Infrastructure</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">DNS, email authentication, and server operations — vendor transitions without disruption.</p>
        <div class="mt-5 flex flex-wrap gap-1.5">
          <span class="chip">Hetzner</span><span class="chip">Google Workspace</span><span class="chip">SPF · DKIM · DMARC</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles: band with joined grid -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-subtle)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-20">
      <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">What you can count on</p>
      <h2 class="fade-in !mt-3 max-w-[26ch]">Fixed principles, <span class="grad-text">whatever the task</span>.</h2>
      <div class="fade-in mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-xl border border-[var(--color-rule)] bg-[var(--color-rule)] overflow-hidden">
        <div class="bg-[var(--color-bg)] p-6">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">01</p>
          <h3 class="!mt-2 text-base font-medium font-[var(--font-sans)]">You own the code</h3>
          <p class="mt-1.5 text-sm text-[var(--color-muted)]">Everything in your repo, on your domain — no lock-in.</p>
        </div>
        <div class="bg-[var(--color-bg)] p-6">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">02</p>
          <h3 class="!mt-2 text-base font-medium font-[var(--font-sans)]">One point of contact</h3>
          <p class="mt-1.5 text-sm text-[var(--color-muted)]">The same person today and three years from now.</p>
        </div>
        <div class="bg-[var(--color-bg)] p-6">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">03</p>
          <h3 class="!mt-2 text-base font-medium font-[var(--font-sans)]">Rolling engagements</h3>
          <p class="mt-1.5 text-sm text-[var(--color-muted)]">Over fixed price — stop at any time.</p>
        </div>
        <div class="bg-[var(--color-bg)] p-6">
          <p class="font-[var(--font-mono)] text-xs text-[var(--color-accent)]">04</p>
          <h3 class="!mt-2 text-base font-medium font-[var(--font-sans)]">Direct line</h3>
          <p class="mt-1.5 text-sm text-[var(--color-muted)]">Email, phone, or Slack — no ticket system.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA: inverted band -->
  <section class="bg-[var(--color-text)]">
    <div class="max-w-6xl mx-auto px-6 md:px-10 py-14 md:py-16 md:flex items-center justify-between gap-10">
      <div>
        <h2 class="!mt-0 text-[var(--color-bg)]">Have a project in mind?</h2>
        <p class="mt-3 max-w-[52ch] text-sm text-[var(--color-bg)]/70">
          I take on new clients on a rolling basis. Send a short description of the project — I'll reply within two business days.
        </p>
      </div>
      <div class="mt-7 md:mt-0 flex-none">
        <a href={routes.contact[lang]} class="cta-invert inline-flex items-center gap-2 rounded-[10px] bg-[var(--color-bg)] px-5 py-3 text-sm font-medium text-[var(--color-text)]">
          {d.cta.writeToMe}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
