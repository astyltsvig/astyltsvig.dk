---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ShimmerCTA from '~/components/ShimmerCTA.astro';
import { routes, t } from '~/i18n/utils';
import { breadcrumbList, webPage, SITE_URL } from '~/lib/seo';
const lang = 'en' as const;
const d = t(lang);

const services = [
  {
    title: 'Enterprise platform development',
    lede: 'Systems shaped around your business — booking, ERP, and CRM. Three are in daily production today; the oldest has run since 2022. Preferred stack is Laravel and Vue, always adapted to the brief.',
    stack: 'Preferred: Laravel · Vue',
    items: [
      'New platforms — from architecture to production',
      'Long-term operation: hosting, deploys, and support',
      'Continued development and optimisation of existing codebases',
      'Integrations: payments, accounting, calendar, and identity',
    ],
  },
  {
    title: 'Websites & CMS migrations',
    lede: 'From heavy WordPress to fast, static sites — with content and URL structure intact. Astro with a headless CMS as the default.',
    stack: 'Astro · Sveltia · Decap · Cloudflare Pages',
    items: [
      'WordPress → Astro/Sveltia with content and URLs preserved',
      'New sites built from scratch',
      'Hosting on Cloudflare Pages — often free to run',
      'Editor onboarding and documentation',
    ],
  },
  {
    title: 'Infrastructure & operations',
    lede: 'The foundation that simply has to work — DNS, email, and servers. Migrations carried out without disruption.',
    stack: 'Hetzner · Cloudflare · SPF/DKIM/DMARC · Google Workspace',
    items: [
      'DNS moves between providers — without email downtime',
      'SPF, DKIM, and DMARC set up properly',
      'Google Workspace administration and user management',
      'Server operations on Hetzner with backups',
    ],
  },
  {
    title: 'Technical advisory',
    lede: 'A technical sparring partner when the decision is big and there is no CTO in the building.',
    stack: 'Strategy · Architecture · Review',
    items: [
      'Assessment of systems and vendor agreements',
      'Architecture and stack choices ahead of a tender',
      'Code review and security review',
    ],
  },
];
const description = 'AStyltsvig Consulting offers enterprise platform development in Laravel and Vue, websites and CMS migrations, plus DNS/email infrastructure and technical advisory.';
const jsonLd = [
  webPage({ lang, path: '/en/services', name: 'Services — AStyltsvig Consulting', description }),
  breadcrumbList([
    { name: 'Home', path: '/en/' },
    { name: 'Services', path: '/en/services' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.title,
        description: s.lede,
        provider: { '@id': `${SITE_URL}/#consulting` },
        areaServed: ['DK', 'EU', 'Worldwide'],
      },
    })),
  },
];
---
<BaseLayout
  lang={lang}
  title="Services — AStyltsvig Consulting (Laravel, Vue, enterprise platforms)"
  description={description}
  jsonLd={jsonLd}
>
  <article class="max-w-6xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-16">
    <p class="fade-in font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-muted)]">Services</p>
    <h1 class="fade-in !mt-4 max-w-[22ch]">
      Four areas. <span class="grad-text">One core engagement</span>.
    </h1>
    <p class="fade-in mt-8 max-w-[60ch] text-lg text-[var(--color-muted)]">
      Everything starts from your needs — not from a standard package. Platform development and operation is the core engagement; the rest flexes around it, as a rolling agreement or fixed estimate.
    </p>

    <div class="mt-16 grid gap-6">
      {services.map((s, i) => (
        <div class="fade-in glass p-7 md:p-10" style={`transition-delay: ${i * 60}ms`}>
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="!mt-0 text-3xl md:text-4xl">{s.title}</h2>
            <span class="chip">{s.stack}</span>
          </div>
          <p class="mt-5 text-[var(--color-muted)] max-w-[64ch]">{s.lede}</p>
          <ul class="mt-6 grid gap-2 md:grid-cols-2 text-sm">
            {s.items.map(item => (
              <li class="flex gap-2.5">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-none"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-20 fade-in flex justify-center">
      <ShimmerCTA href={routes.contact[lang]} variant="primary">{d.cta.writeToMe}</ShimmerCTA>
    </div>
  </article>
</BaseLayout>
