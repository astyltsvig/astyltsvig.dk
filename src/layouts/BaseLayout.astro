---
import '@fontsource-variable/schibsted-grotesk';
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { shared } from '~/copy/shared';
import type { AltPaths, Lang } from '~/i18n/routes';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Equivalent path in each locale — drives hreflang and the language switcher. Omit to disable (404). */
  altPaths?: AltPaths;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  altPaths,
  canonicalPath,
  jsonLd,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  image,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://astyltsvig.dk';
const siteName = 'AStyltsvig Consulting';
const author = 'Andreas Sørbye Styltsvig';
const s = shared[lang];
const path = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(path, siteUrl).toString();
const daUrl = altPaths ? new URL(altPaths.da, siteUrl).toString() : undefined;
const enUrl = altPaths ? new URL(altPaths.en, siteUrl).toString() : undefined;
const ogImage = new URL(image ?? '/og-default.png', siteUrl).toString();
const ogLocale = lang === 'da' ? 'da_DK' : 'en_GB';
const ogLocaleAlt = lang === 'da' ? 'en_GB' : 'da_DK';
const robots = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="publisher" content={siteName} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonical} />

    {daUrl && <link rel="alternate" hreflang="da" href={daUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {daUrl && <link rel="alternate" hreflang="x-default" href={daUrl} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${siteName} — ${author}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${siteName} — ${author}`} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FAFAF8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-title" content="AStyltsvig" />
    <meta name="application-name" content="AStyltsvig Consulting" />

    {jsonLdArray.map(ld => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <ClientRouter />
    <noscript>
      <style>
        .reveal { opacity: 1; transform: none; }
      </style>
    </noscript>
  </head>
  <body class="min-h-dvh flex flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:text-paper focus:px-4 focus:py-2"
    >
      {s.skipToContent}
    </a>
    <Header lang={lang} altPaths={altPaths} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const initReveal = () => {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          els.forEach(el => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -60px 0px', threshold: 0.05 }
        );
        els.forEach(el => io.observe(el));
      };
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
