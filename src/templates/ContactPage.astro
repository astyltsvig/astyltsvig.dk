---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import { routes, type Lang } from '~/i18n/routes';
import { contact } from '~/copy/contact';
import { shared } from '~/copy/shared';
import { breadcrumbList, webPage } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = contact[lang];
const s = shared[lang];
const path = routes.contact[lang];

const jsonLd = [
  webPage({ lang, path, name: c.meta.title, description: c.meta.description, type: 'ContactPage' }),
  breadcrumbList([
    { name: s.nav.home, path: routes.home[lang] },
    { name: s.nav.contact, path },
  ]),
];
---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: routes.contact.da, en: routes.contact.en }}
  jsonLd={jsonLd}
  image={`/og/contact-${lang}.png`}
>
  <PageIntro eyebrow={c.intro.eyebrow} heading={c.intro.heading} lede={c.intro.lede} />

  {/* The direct line: the same ink/green contrast the intro opens with, carrying the one thing this page exists for. */}
  <section class="bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24">
      <p class="eyebrow !text-paper/50 reveal">{c.direct.eyebrow}</p>
      <a
        href={`mailto:${c.direct.email}`}
        class="mt-5 inline-block break-all text-[clamp(1.75rem,5.5vw,4rem)] font-semibold tracking-tight text-accent-soft underline underline-offset-8 decoration-1 hover:text-paper transition-colors duration-150 reveal"
        style="--reveal-delay: 90ms"
      >
        {c.direct.email}
      </a>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5 reveal" style="--reveal-delay: 180ms">
        <button
          type="button"
          data-copy-email={c.direct.email}
          data-copied-label={c.direct.copied}
          class="inline-flex items-center gap-2.5 border border-paper/25 px-5 py-2.5 text-[0.9375rem] font-medium hover:border-accent-soft hover:text-accent-soft transition-colors duration-150 cursor-pointer"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="1" />
            <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
          </svg>
          <span data-copy-label aria-live="polite">{c.direct.copy}</span>
        </button>
        <p class="text-paper/70">{c.direct.note}</p>
      </div>
      <ul class="mt-11 flex flex-wrap gap-x-8 gap-y-1 border-t border-paper/10 pt-5 font-mono text-xs uppercase tracking-[0.1em] text-paper/50 reveal" style="--reveal-delay: 260ms">
        {c.direct.meta.map(item => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24">
    <div class="grid gap-14 md:grid-cols-2 md:gap-16">
      <div>
        <p class="eyebrow reveal">{c.guide.eyebrow}</p>
        <h2 class="mt-4 max-w-[22ch] text-[clamp(1.5rem,3vw,2rem)] reveal" style="--reveal-delay: 80ms">{c.guide.heading}</h2>
        <ol class="mt-9">
          {c.guide.items.map((item, i) => (
            <li class="grid grid-cols-[3.25rem_minmax(0,1fr)] gap-4 border-t border-line py-5 reveal" style={`--reveal-delay: ${160 + i * 100}ms`}>
              <span class="font-mono text-sm text-accent pt-0.5" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-base font-semibold tracking-tight">{item.title}</h3>
                <p class="mt-1 text-[0.9375rem] text-muted">{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="reveal" style="--reveal-delay: 120ms">
        <p class="eyebrow">{c.facts.eyebrow}</p>
        <dl class="mt-9 border-t border-line">
          {c.facts.items.map(item => (
            <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-3 border-b border-line">
              <dt class="eyebrow pt-0.5">{item.label}</dt>
              <dd class="text-[0.9375rem]">
                {item.value.startsWith('github.com') || item.value.startsWith('linkedin.com') ? (
                  <a
                    href={`https://${item.value}`}
                    rel="me noopener"
                    class="text-accent underline underline-offset-4 decoration-1 hover:text-accent-strong transition-colors duration-150"
                  >
                    {item.value}
                  </a>
                ) : (
                  item.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = '1';
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    const idle = label?.textContent ?? '';
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
      } catch {
        return;
      }
      if (!label) return;
      label.textContent = button.dataset.copiedLabel ?? idle;
      clearTimeout(timer);
      timer = setTimeout(() => {
        label.textContent = idle;
      }, 2000);
    });
  }

  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
</script>
