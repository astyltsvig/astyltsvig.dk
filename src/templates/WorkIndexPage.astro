---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import ProjectTile from '~/components/ProjectTile.astro';
import ContactCta from '~/components/ContactCta.astro';
import { categoryAnchors, routes, type Lang } from '~/i18n/routes';
import { shared } from '~/copy/shared';
import { work } from '~/copy/work';
import { getCases, groupByCategory } from '~/lib/cases';
import { breadcrumbList, webPage } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = work[lang];
const s = shared[lang];
const cases = await getCases(lang);
const path = routes.work[lang];
// Client work first, grouped by kind; own products last, so visitors see what I do for clients up front.
const groups = [...groupByCategory(cases)];

const jsonLd = [
  webPage({ lang, path, name: c.meta.title, description: c.meta.description, type: 'CollectionPage' }),
  breadcrumbList([
    { name: s.nav.home, path: routes.home[lang] },
    { name: s.nav.work, path },
  ]),
];
---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: routes.work.da, en: routes.work.en }}
  jsonLd={jsonLd}
  image={`/og/work-${lang}.png`}
>
  <PageIntro eyebrow={c.intro.eyebrow} heading={c.intro.heading} lede={c.intro.lede} />

  <nav class="mx-auto max-w-6xl px-6 md:px-10 pb-10 md:pb-14" aria-label={c.jumpLabel}>
    <ul class="flex flex-wrap gap-2 reveal">
      {groups.map(([key, members]) => (
        <li>
          <a
            href={`#${categoryAnchors[key]}`}
            class="inline-flex items-center gap-2 border border-line bg-surface px-4 py-2 text-[0.9375rem] hover:border-accent hover:text-accent transition-colors duration-150"
          >
            {s.categories[key]}
            <span class="font-mono text-xs text-muted">{members.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {groups.map(([key, members]) => (
    <section id={categoryAnchors[key]} class="scroll-mt-6 mx-auto max-w-6xl px-6 md:px-10 py-12 md:py-16 border-t border-line">
      <div class="md:flex md:items-end md:justify-between md:gap-10">
        <h2 class="text-[clamp(1.5rem,3vw,2.25rem)] reveal">{s.categories[key]}</h2>
        <p class="mt-3 md:mt-0 max-w-[52ch] text-muted reveal" style="--reveal-delay: 80ms">{s.categoryLede[key]}</p>
      </div>
      <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((entry, i) => <ProjectTile entry={entry} lang={lang} index={i} />)}
      </ul>
    </section>
  ))}

  <ContactCta lang={lang} />
</BaseLayout>
