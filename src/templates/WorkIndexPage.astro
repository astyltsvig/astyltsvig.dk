---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import ProjectFeature from '~/components/ProjectFeature.astro';
import ContactCta from '~/components/ContactCta.astro';
import { routes, type Lang } from '~/i18n/routes';
import { shared } from '~/copy/shared';
import { work } from '~/copy/work';
import { getCases } from '~/lib/cases';
import { breadcrumbList, webPage } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = work[lang];
const s = shared[lang];
const cases = await getCases(lang);
const path = routes.work[lang];

const jsonLd = [
  webPage({ lang, path, name: c.meta.title, description: c.meta.description, type: 'CollectionPage' }),
  breadcrumbList([
    { name: s.nav.home, path: routes.home[lang] },
    { name: s.nav.work, path },
  ]),
];
---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: routes.work.da, en: routes.work.en }}
  jsonLd={jsonLd}
  image={`/og/work-${lang}.png`}
>
  <PageIntro eyebrow={c.intro.eyebrow} heading={c.intro.heading} lede={c.intro.lede} />

  <section class="mx-auto max-w-6xl px-6 md:px-10 pb-16 md:pb-24">
    <ul>
      {cases.map((entry, i) => (
        <ProjectFeature entry={entry} lang={lang} index={i} headingLevel="h2" />
      ))}
    </ul>
  </section>

  <ContactCta lang={lang} />
</BaseLayout>
