---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ContactCta from '~/components/ContactCta.astro';
import Button from '~/components/Button.astro';
import { landingRoutes, routes, type LandingKey, type Lang } from '~/i18n/routes';
import { landing } from '~/copy/landing';
import { shared } from '~/copy/shared';
import { getCases } from '~/lib/cases';
import { breadcrumbList, SITE_URL, webPage } from '~/lib/seo';

interface Props {
  lang: Lang;
  page: LandingKey;
}

const { lang, page } = Astro.props;
const c = landing[page][lang];
const s = shared[lang];
const path = landingRoutes[page][lang];

const allCases = await getCases(lang);
const cases = c.cases.slugs
  .map(slug => allCases.find(entry => entry.slug === slug))
  .filter(entry => entry !== undefined);

const jsonLd = [
  webPage({ lang, path, name: c.meta.title, description: c.meta.description }),
  breadcrumbList([
    { name: s.nav.home, path: routes.home[lang] },
    { name: s.nav.services, path: routes.services[lang] },
    { name: c.serviceName, path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE_URL}${path}#service`,
    name: c.serviceName,
    description: c.meta.description,
    url: `${SITE_URL}${path}`,
    provider: { '@id': `${SITE_URL}/#consulting` },
    areaServed: ['DK', 'EU'],
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faq.items.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: landingRoutes[page].da, en: landingRoutes[page].en }}
  jsonLd={jsonLd}
  image={`/og/service-${page}-${lang}.png`}
>
  <PageIntro eyebrow={c.intro.eyebrow} heading={c.intro.heading} lede={c.intro.lede}>
    <div class="mt-10 flex flex-wrap items-center gap-6 reveal" style="--reveal-delay: 240ms">
      <Button href={`mailto:${s.cta.email}`}>{s.cta.email}</Button>
      <Button href={routes.services[lang]} variant="link">{s.nav.services}</Button>
    </div>
  </PageIntro>

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-14 md:py-20 border-t border-line">
    <p class="eyebrow reveal">{c.benefits.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.benefits.heading}</h2>
    <ul class="mt-10 grid gap-8 md:grid-cols-2">
      {c.benefits.items.map((item, i) => (
        <li class="border-t-2 border-accent pt-5 reveal" style={`--reveal-delay: ${160 + (i % 2) * 100}ms`}>
          <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
          <p class="mt-2 max-w-[52ch] text-[0.9375rem] text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-14 md:py-20 border-t border-line">
    <div class="grid gap-10 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:gap-16">
      <div class="reveal">
        <p class="eyebrow">{c.details.eyebrow}</p>
        <h2 class="mt-4 text-[clamp(1.5rem,3vw,2.25rem)]">{c.details.heading}</h2>
      </div>
      <ul class="max-w-[62ch] space-y-5">
        {c.details.items.map((item, j) => (
          <li class="flex gap-4 reveal" style={`--reveal-delay: ${100 + j * 80}ms`}>
            <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 L9 17 L4 12" />
            </svg>
            <span class="text-[0.9375rem] text-muted">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 md:px-10 py-14 md:py-20 border-t border-line">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow reveal">{c.cases.eyebrow}</p>
          <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.cases.heading}</h2>
        </div>
        <Button href={routes.work[lang]} variant="link">{s.nav.work}</Button>
      </div>
      <ul class="mt-12 grid gap-x-10 gap-y-16 md:grid-cols-2">
        {cases.map((entry, i) => <ProjectCard entry={entry} lang={lang} index={i} />)}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-14 md:py-20 border-t border-line">
    <p class="eyebrow reveal">{c.faq.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.faq.heading}</h2>
    <div class="mt-10 max-w-[70ch] divide-y divide-line border-y border-line">
      {c.faq.items.map(item => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold tracking-tight">
            <span>{item.q}</span>
            <span aria-hidden="true" class="mt-0.5 text-accent transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[0.9375rem] text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <ContactCta lang={lang} heading={c.ctaHeading} />
</BaseLayout>
