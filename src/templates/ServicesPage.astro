---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import ContactCta from '~/components/ContactCta.astro';
import ServiceIcon from '~/components/ServiceIcon.astro';
import { caseUrl, landingRoutes, routes, serviceAnchors, type Lang, type ServiceKey } from '~/i18n/routes';
import { serviceCases, serviceOrder, services } from '~/copy/services';
import { shared } from '~/copy/shared';
import { getCases } from '~/lib/cases';
import { breadcrumbList, SITE_URL, webPage } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = services[lang];
const s = shared[lang];
const path = routes.services[lang];
const cases = await getCases(lang);

// Each card leads to the landing page that goes deeper on it; business development leads to a conversation.
const cards = serviceOrder.map((key: ServiceKey) => {
  const item = c.items[key];
  const examples = serviceCases[key]
    .map(slug => cases.find(entry => entry.slug === slug))
    .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);
  const href = key === 'business' ? routes.contact[lang] : landingRoutes[key][lang];
  const linkLabel = key === 'business' ? c.cards.talk : c.cards.readMore;
  return { key, item, examples, href, linkLabel };
});

const jsonLd = [
  webPage({ lang, path, name: c.meta.title, description: c.meta.description }),
  breadcrumbList([
    { name: s.nav.home, path: routes.home[lang] },
    { name: s.nav.services, path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: cards.map((card, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: card.item.title,
        description: card.item.lede,
        provider: { '@id': `${SITE_URL}/#consulting` },
        areaServed: ['DK', 'EU'],
      },
    })),
  },
];
---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: routes.services.da, en: routes.services.en }}
  jsonLd={jsonLd}
  image={`/og/services-${lang}.png`}
>
  <PageIntro eyebrow={c.intro.eyebrow} heading={c.intro.heading} lede={c.intro.lede} />

  <section class="mx-auto max-w-6xl px-6 md:px-10 pb-16 md:pb-24">
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cards.map((card, i) => (
        <li id={serviceAnchors[card.key]} class="scroll-mt-6 reveal" style={`--reveal-delay: ${(i % 2) * 100}ms`}>
          <article class="group flex h-full flex-col border border-line bg-surface p-7 md:p-8 transition-colors duration-200 hover:border-accent">
            <span class="flex h-12 w-12 items-center justify-center bg-accent/10 text-accent">
              <ServiceIcon name={card.key} class="h-7 w-7" />
            </span>
            <h2 class="mt-6 text-xl md:text-[1.375rem] font-semibold tracking-tight leading-tight">
              <a href={card.href} class="hover:text-accent transition-colors duration-150">{card.item.title}</a>
            </h2>
            <p class="mt-3 text-muted lg:min-h-[7.25rem]">{card.item.lede}</p>
            <ul class="mt-6 space-y-2.5">
              {card.item.points.map(point => (
                <li class="flex gap-3 text-[0.9375rem]">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 L9 17 L4 12" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              {card.examples.length > 0 && (
                <p class="border-t border-line pt-5 text-[0.875rem] text-muted md:min-h-[6.25rem]">
                  <span class="block font-mono text-[0.6875rem] uppercase tracking-[0.12em]">{c.cards.examples}</span>
                  <span class="mt-2 block">
                    {card.examples.map((entry, j) => (
                      <>
                        <a href={caseUrl(lang, entry.slug)} class="text-ink underline underline-offset-4 decoration-line hover:text-accent hover:decoration-accent transition-colors duration-150">{entry.data.client}</a>{j < card.examples.length - 1 ? ' · ' : ''}
                      </>
                    ))}
                  </span>
                </p>
              )}
              <a href={card.href} class="group/link mt-6 inline-flex items-center gap-2 font-medium text-accent">
                {card.linkLabel}<span class="sr-only">: {card.item.title}</span>
                <span aria-hidden="true" class="transition-transform duration-200 group-hover/link:translate-x-1">→</span>
              </a>
            </div>
          </article>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-muted reveal">
      {c.other.text}{' '}
      <a href={routes.contact[lang]} class="font-medium text-accent underline underline-offset-4 decoration-1 hover:text-accent-strong">{c.other.link}</a>
    </p>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24">
      <p class="eyebrow reveal">{c.process.eyebrow}</p>
      <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.process.heading}</h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {c.process.steps.map((step, i) => (
          <li class="border-t-2 border-accent pt-5 reveal" style={`--reveal-delay: ${160 + i * 90}ms`}>
            <h3 class="text-lg font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-2 text-[0.9375rem] text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactCta lang={lang} />
</BaseLayout>
