---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import ContactCta from '~/components/ContactCta.astro';
import { categoryAnchors, landingRoutes, routes, serviceAnchors, type Lang } from '~/i18n/routes';
import { landing, landingOrder } from '~/copy/landing';
import { services } from '~/copy/services';
import { shared } from '~/copy/shared';
import { breadcrumbList, SITE_URL, webPage } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = services[lang];
const s = shared[lang];
const path = routes.services[lang];
// Per service section: its anchor, the landing page that goes deeper (if any) and the matching case group.
const serviceLinks = [
  { landing: landingRoutes.platforms[lang], cases: `${routes.work[lang]}#${categoryAnchors.platform}` },
  { landing: landingRoutes.websites[lang], cases: `${routes.work[lang]}#${categoryAnchors.web}` },
  { landing: undefined, cases: `${routes.work[lang]}#${categoryAnchors.operations}` },
];

const jsonLd = [
  webPage({ lang, path, name: c.meta.title, description: c.meta.description }),
  breadcrumbList([
    { name: s.nav.home, path: routes.home[lang] },
    { name: s.nav.services, path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: c.services.map((service, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: service.title,
        description: service.lede,
        provider: { '@id': `${SITE_URL}/#consulting` },
        areaServed: ['DK', 'EU'],
      },
    })),
  },
];
---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: routes.services.da, en: routes.services.en }}
  jsonLd={jsonLd}
  image={`/og/services-${lang}.png`}
>
  <PageIntro eyebrow={c.intro.eyebrow} heading={c.intro.heading} lede={c.intro.lede} />

  <section class="mx-auto max-w-6xl px-6 md:px-10 pb-14 md:pb-20">
    <p class="eyebrow reveal">{c.approach.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.approach.heading}</h2>
    <ol class="mt-10 grid gap-8 md:grid-cols-3">
      {c.approach.steps.map((step, i) => (
        <li class="border-t-2 border-accent pt-5 reveal" style={`--reveal-delay: ${160 + i * 100}ms`}>
          <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 text-lg font-semibold tracking-tight">{step.title}</h3>
          <p class="mt-2 text-[0.9375rem] text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10 pt-14 md:pt-20 pb-4 border-t border-line">
    <p class="eyebrow reveal">{c.delivered.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.delivered.heading}</h2>
  </section>

  {c.services.map((service, i) => (
    <section id={serviceAnchors[i]} class="scroll-mt-6 mx-auto max-w-6xl px-6 md:px-10 py-14 md:py-24 border-t border-line">
      <div class="grid gap-10 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:gap-16">
        <div class="reveal">
          <span class="ghost-num block select-none font-semibold leading-none tracking-tight text-[clamp(4.5rem,9vw,7rem)] text-line" data-num={String(i + 1).padStart(2, '0')} aria-hidden="true"></span>
          <h2 class="mt-3 text-[clamp(1.5rem,3vw,2.25rem)]">{service.title}</h2>
          <ul class="mt-6 flex flex-wrap gap-2">
            {service.stack.split(' · ').map(keyword => (
              <li class="border border-line bg-surface px-3 py-1 font-mono text-xs text-muted">{keyword}</li>
            ))}
          </ul>
        </div>
        <div class="min-w-0">
          <p class="max-w-[44ch] text-xl md:text-2xl font-medium tracking-tight reveal" style="--reveal-delay: 100ms">{service.lede}</p>
          <ul class="mt-9 max-w-[62ch] space-y-5">
            {service.items.map((item, j) => (
              <li class="flex gap-4 reveal" style={`--reveal-delay: ${180 + j * 90}ms`}>
                <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 L9 17 L4 12" />
                </svg>
                <span class="text-[0.9375rem] text-muted">{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4 reveal" style="--reveal-delay: 300ms">
            {serviceLinks[i]?.landing && (
              <a href={serviceLinks[i].landing} class="group inline-flex items-center gap-2 text-[0.9375rem] font-medium text-accent">
                {c.links.readMore}
                <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
              </a>
            )}
            {serviceLinks[i] && (
              <a href={serviceLinks[i].cases} class="text-[0.9375rem] font-medium text-ink underline underline-offset-4 decoration-1 decoration-line hover:text-accent hover:decoration-accent transition-colors duration-150">
                {c.links.cases}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-14 md:py-20 border-t border-line">
    <p class="eyebrow reveal">{c.specialties.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.specialties.heading}</h2>
    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {landingOrder.map((key, i) => {
        const page = landing[key][lang];
        return (
          <li class="reveal" style={`--reveal-delay: ${160 + i * 100}ms`}>
            <a href={landingRoutes[key][lang]} class="group block h-full border border-line bg-surface p-6 hover:border-accent transition-colors duration-200">
              <h3 class="text-lg font-semibold tracking-tight group-hover:text-accent transition-colors duration-150">{page.serviceName}</h3>
              <p class="mt-2 text-[0.9375rem] text-muted">{page.intro.heading}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-[0.9375rem] font-medium text-accent">
                {c.specialties.readMore}
                <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10 pb-16 md:pb-24 pt-4">
    <div class="border border-line border-l-2 border-l-accent bg-surface p-8 md:p-12 reveal">
      <p class="eyebrow">{c.process.eyebrow}</p>
      <h2 class="mt-3 text-[clamp(1.5rem,3vw,2.25rem)]">{c.process.heading}</h2>
      <p class="mt-4 max-w-[62ch] text-muted">{c.process.text}</p>
    </div>
  </section>

  <ContactCta lang={lang} />
</BaseLayout>

<style>
  /* Decorative ghost numeral lives in CSS content so it never reaches
     assistive tech or contrast rules — it is pure ornament. */
  .ghost-num::before {
    content: attr(data-num);
  }
</style>
