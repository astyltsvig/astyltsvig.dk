---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactCta from '~/components/ContactCta.astro';
import { routes, type Lang } from '~/i18n/routes';
import { about } from '~/copy/about';
import { shared } from '~/copy/shared';
import { breadcrumbList, webPage } from '~/lib/seo';
import portrait from '~/assets/andreas-styltsvig.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = about[lang];
const s = shared[lang];
const path = routes.about[lang];

const jsonLd = [
  webPage({ lang, path, name: c.meta.title, description: c.meta.description, type: 'AboutPage' }),
  breadcrumbList([
    { name: s.nav.home, path: routes.home[lang] },
    { name: s.nav.about, path },
  ]),
];

---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: routes.about.da, en: routes.about.en }}
  jsonLd={jsonLd}
  ogType="profile"
  image={`/og/about-${lang}.png`}
>
  {/* 1. Who: name, one-line pitch and three quick facts. */}
  <section class="mx-auto max-w-6xl px-6 md:px-10 pt-16 md:pt-24 pb-12 md:pb-16">
    <p class="eyebrow reveal">{c.intro.eyebrow}</p>
    <h1 class="mt-4 max-w-[16ch] text-[clamp(2.5rem,6vw,4.5rem)] reveal" style="--reveal-delay: 80ms">{c.intro.heading}</h1>
    <p class="mt-6 max-w-[52ch] text-lg text-muted reveal" style="--reveal-delay: 160ms">{c.intro.lede}</p>
    <dl class="mt-10 grid max-w-xl grid-cols-2 sm:grid-cols-3 border-t border-line reveal" style="--reveal-delay: 240ms">
      {c.facts.map(f => (
        <div class="pt-4 pr-4">
          <dt class="eyebrow">{f.label}</dt>
          <dd class="mt-1.5 text-[0.9375rem] font-medium">{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* Portrait and the personal story in Andreas' own words. */}
  <section class="mx-auto max-w-6xl px-6 md:px-10 pb-16 md:pb-24">
    <div class="grid gap-10 md:grid-cols-[18rem_minmax(0,1fr)] md:gap-16">
      <Image
        src={portrait}
        alt={c.portraitAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 288px, 60vw"
        format="webp"
        quality={82}
        loading="eager"
        class="w-48 md:w-full h-auto border border-line bg-surface reveal md:sticky md:top-24"
      />
      <div class="max-w-[62ch] space-y-5">
        {c.bio.map((paragraph, i) => <p class="reveal" style={`--reveal-delay: ${80 + i * 80}ms`}>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {/* 2. What it is like to work together. */}
  <section class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24 border-t border-line">
    <p class="eyebrow reveal">{c.principles.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.principles.heading}</h2>
    <ol class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
      {c.principles.items.map((item, i) => (
        <li class="border-t-2 border-accent pt-5 reveal" style={`--reveal-delay: ${i * 80}ms`}>
          <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-lg font-semibold tracking-tight">{item.title}</h3>
          <p class="mt-2 text-[0.9375rem] text-muted max-w-[44ch]">{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* 3. Background: short timeline next to the toolbox. */}
  <section class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24 border-t border-line">
    <p class="eyebrow reveal">{c.background.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.background.heading}</h2>
    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:gap-16">
      <ol class="border-t border-line">
        {c.background.steps.map((step, i) => (
          <li class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-4 py-4 border-b border-line reveal" style={`--reveal-delay: ${Math.min(i * 70, 280)}ms`}>
            <span class="font-mono text-sm text-muted pt-0.5">{step.year}</span>
            <p class="text-[0.9375rem]">{step.text}</p>
          </li>
        ))}
      </ol>
      <div class="reveal" style="--reveal-delay: 160ms">
        <h3 class="eyebrow">{c.background.toolsHeading}</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {c.background.tools.map(tool => (
            <li class="border border-line bg-surface px-3 py-1.5 font-mono text-[0.8125rem]">{tool}</li>
          ))}
        </ul>
        <p class="mt-6 text-[0.9375rem] text-muted max-w-[44ch]">{c.background.ai}</p>
      </div>
    </div>
  </section>

  <ContactCta lang={lang} />
</BaseLayout>
