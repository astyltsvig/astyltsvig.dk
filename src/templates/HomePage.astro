---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import ClientLogos from '~/components/ClientLogos.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Screenshot from '~/components/Screenshot.astro';
import ContactCta from '~/components/ContactCta.astro';
import { routes, type Lang } from '~/i18n/routes';
import { home } from '~/copy/home';
import { getCases } from '~/lib/cases';
import { personGraph } from '~/lib/seo';
import { Image } from 'astro:assets';
import portrait from '~/assets/andreas-styltsvig.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang];
const cases = await getCases(lang);
const featuredSlugs = ['book2go', 'ddl-tegnsprogspakken', 'smartlinjen', 'festival-sans-pression'];
const featured = featuredSlugs
  .map(slug => cases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);
---
<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPaths={{ da: routes.home.da, en: routes.home.en }}
  jsonLd={personGraph(lang)}
  image={`/og/home-${lang}.png`}
>
  <section class="mx-auto max-w-6xl px-6 md:px-10 pt-20 md:pt-32 pb-16 md:pb-24 lg:grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-12">
    <div>
    <p class="eyebrow reveal">{c.hero.eyebrow}</p>
    <h1 class="mt-5 max-w-[20ch] text-[clamp(2.5rem,6.5vw,4.5rem)] reveal" style="--reveal-delay: 90ms">{c.hero.heading}</h1>
    <p class="mt-7 max-w-[56ch] text-lg text-muted reveal" style="--reveal-delay: 180ms">{c.hero.lede}</p>
    <div class="mt-10 flex flex-wrap items-center gap-6 reveal" style="--reveal-delay: 270ms">
      <Button href={routes.work[lang]}>{c.hero.primaryCta}</Button>
      <Button href={routes.contact[lang]} variant="link">{c.hero.secondaryCta}</Button>
    </div>
    <a href={routes.about[lang]} class="group mt-12 inline-flex items-center gap-4 reveal" style="--reveal-delay: 360ms">
      <Image
        src={portrait}
        alt=""
        width={56}
        height={56}
        densities={[1, 2]}
        format="webp"
        quality={80}
        class="h-14 w-14 rounded-full object-cover ring-1 ring-line group-hover:ring-accent transition-shadow duration-200"
      />
      <span class="leading-tight">
        <span class="block font-semibold tracking-tight group-hover:text-accent transition-colors duration-150">{c.hero.byline.name}</span>
        <span class="block mt-1 text-sm text-muted">{c.hero.byline.role}</span>
      </span>
    </a>
    </div>

    {/* Two real project screenshots, stacked like browser windows. Desktop only. */}
    <div class="relative hidden lg:block reveal" style="--reveal-delay: 240ms" aria-hidden="true">
      <Screenshot
        file="tegnsprogspakken.png"
        alt=""
        frameDomain="tegnsprogspakken.dk"
        loading="eager"
        widths={[480, 720]}
        sizes="360px"
        class="w-[88%] ml-auto shadow-[0_30px_60px_-35px_rgb(27_26_22/0.35)]"
      />
      <Screenshot
        file="smartlinjen.png"
        alt=""
        frameDomain="smartlinjen.dk"
        loading="eager"
        widths={[480, 720, 960]}
        sizes="400px"
        class="relative -mt-[30%] w-[94%] shadow-[0_40px_80px_-30px_rgb(27_26_22/0.45)]"
      />
    </div>
  </section>

  <ClientLogos lang={lang} />

  <section class="border-y border-line">
    <dl class="mx-auto max-w-6xl px-6 md:px-10 grid grid-cols-2 md:grid-cols-4">
      {c.facts.map((fact, i) => (
        <div
          class:list={[
            'py-8 md:py-10 reveal',
            i % 2 === 1 && 'pl-6 border-l border-line',
            i >= 2 && 'border-t border-line md:border-t-0',
            i === 2 && 'md:pl-6 md:border-l',
          ]}
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <dt class="sr-only">{fact.label}</dt>
          <dd class="text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-none tracking-[-0.03em] text-accent">{fact.value}</dd>
          <dd class="mt-3 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted">{fact.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow reveal">{c.work.eyebrow}</p>
        <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.work.heading}</h2>
      </div>
      <Button href={routes.work[lang]} variant="link">{c.work.allLink}</Button>
    </div>
    <ul class="mt-12 grid gap-x-10 gap-y-16 md:grid-cols-2">
      {featured.map((entry, i) => <ProjectCard entry={entry} lang={lang} index={i} />)}
    </ul>
    <div class="mt-16 border-t border-line pt-10 text-center">
      <Button href={routes.work[lang]}>{c.work.allLink}</Button>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24 border-t border-line">
    <p class="eyebrow reveal">{c.services.eyebrow}</p>
    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.75rem,4vw,2.75rem)] reveal" style="--reveal-delay: 80ms">{c.services.heading}</h2>
    <ol class="mt-10 grid gap-4 md:grid-cols-3 md:gap-6">
      {c.services.items.map((item, i) => (
        <li class="reveal" style={`--reveal-delay: ${i * 90}ms`}>
          <a
            href={routes.services[lang]}
            class="group flex h-full flex-col border border-line bg-surface p-6 md:p-8 hover:border-accent transition-colors duration-200"
          >
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-6 text-xl font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] text-muted">{item.text}</p>
            <span aria-hidden="true" class="mt-auto pt-6 text-accent transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="mt-10">
      <Button href={routes.services[lang]} variant="link">{c.services.link}</Button>
    </div>
  </section>

  <ContactCta lang={lang} />
</BaseLayout>
