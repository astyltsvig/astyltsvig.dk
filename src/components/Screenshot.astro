---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  file: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  widths?: number[];
  sizes?: string;
  class?: string;
  /** Renders a slim browser-chrome bar with this domain above the image. */
  frameDomain?: string;
}

const {
  file,
  alt,
  loading = 'lazy',
  widths = [640, 960, 1280, 1920],
  sizes = '(min-width: 1200px) 1120px, 100vw',
  class: className,
  frameDomain,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/cases/*.{png,jpg,jpeg,webp}');
const importer = images[`/src/assets/cases/${file}`];
const image = importer ? (await importer()).default : undefined;
---
{image && (
  <div class:list={['border border-line bg-surface overflow-hidden', className]}>
    {frameDomain && (
      <div class="flex items-center gap-2 border-b border-line bg-paper px-4 py-2.5">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        </span>
        <span class="mx-auto -translate-x-3 rounded-sm bg-surface border border-line px-3 py-0.5 font-mono text-[0.6875rem] text-muted">
          {frameDomain}
        </span>
      </div>
    )}
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={82}
      loading={loading}
      class="block w-full h-auto transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    />
  </div>
)}
