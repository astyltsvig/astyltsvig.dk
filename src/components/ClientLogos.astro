---
import { Image } from 'astro:assets';
import type { Lang } from '~/i18n/routes';
import { home } from '~/copy/home';
import mallard from '~/assets/clients/mallard.png';
import cpof from '~/assets/clients/care-pension-forsikring.png';
import ddl from '~/assets/clients/ddl.png';
import df1866 from '~/assets/clients/df1866-lockup.png';
import cua from '~/assets/clients/cycling-without-age.png';
import securelife from '~/assets/clients/securelife.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].clients;

/* A calm, static row: logos in muted greyscale that take their own colour on hover. */
const logos = [
  { image: mallard, name: 'Mallard' },
  { image: securelife, name: 'SecureLife' },
  { image: cpof, name: 'Care Pension & Forsikring' },
  { image: ddl, name: 'Danske Døves Landsforbund' },
  { image: df1866, name: 'Døveforeningen af 1866' },
  { image: cua, name: 'Cycling Without Age' },
];
---
<section class="border-y border-line">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-10 md:py-12 reveal">
    <p class="eyebrow">{c.eyebrow}</p>
    <ul class="mt-7 grid grid-cols-2 items-center gap-x-8 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
      {logos.map(logo => (
        <li class="flex h-12 items-center justify-center lg:justify-start">
          <Image
            src={logo.image}
            alt={logo.name}
            height={48}
            densities={[1, 2]}
            format="webp"
            quality={85}
            class="max-h-9 md:max-h-10 w-auto max-w-[9rem] object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-200"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
