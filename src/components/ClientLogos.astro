---
import { Image } from 'astro:assets';
import type { Lang } from '~/i18n/routes';
import { home } from '~/copy/home';
import mallard from '~/assets/clients/mallard.png';
import cpof from '~/assets/clients/care-pension-forsikring.png';
import ddl from '~/assets/clients/ddl.png';
import tegnsprogspakken from '~/assets/clients/ddl-tegnsprogspakken.png';
import df1866 from '~/assets/clients/df1866.png';
import fsp from '~/assets/clients/festival-sans-pression.webp';
import cua from '~/assets/clients/cycling-without-age.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].clients;

const logos = [
  { image: mallard, name: 'Mallard' },
  { image: cpof, name: 'Care Pension & Forsikring' },
  { image: ddl, name: 'Danske Døves Landsforbund' },
  { image: tegnsprogspakken, name: 'Tegnsprogspakken' },
  { image: df1866, name: 'Døveforeningen af 1866' },
  { image: cua, name: 'Cycling Without Age' },
  { image: fsp, name: 'Festival Sans Pression' },
];

const wordmarks = ['SecureLife'];
---
<section class="py-10 md:py-14 reveal">
  <p class="eyebrow mx-auto max-w-6xl px-6 md:px-10">{c.eyebrow}</p>
  <div class="marquee mt-8">
    <div class="marquee-track">
      {[false, true].map(isClone => (
        <ul class="marquee-group" aria-hidden={isClone ? 'true' : undefined}>
          {logos.map(logo => (
            <li>
              <Image
                src={logo.image}
                alt={isClone ? '' : logo.name}
                height={48}
                densities={[1, 2]}
                format="webp"
                quality={85}
                loading="eager"
                class="h-10 md:h-12 w-auto grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-150"
              />
            </li>
          ))}
          {wordmarks.map(name => (
            <li class="text-xl font-semibold tracking-tight text-muted/80 hover:text-ink transition-colors duration-150 whitespace-nowrap">
              {name}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 35s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 5rem;
    padding-right: 5rem;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }

    .marquee-track {
      animation: none;
      width: auto;
      margin-inline: auto;
      max-width: 72rem;
      padding-inline: 1.5rem;
    }

    .marquee-group {
      flex-wrap: wrap;
      padding-right: 0;
      gap: 3rem;
    }

    .marquee-group[aria-hidden='true'] {
      display: none;
    }
  }
</style>
