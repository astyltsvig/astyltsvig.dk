---
import { routes, type Lang } from '~/i18n/routes';
import { shared } from '~/copy/shared';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = shared[lang];
const year = new Date().getFullYear();
---
<footer class="border-t border-line mt-24">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-14">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <h2 class="eyebrow">{s.footer.contactHeading}</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem]">
          <li>
            <a href="mailto:hello@astyltsvig.dk" class="hover:text-accent transition-colors duration-150">
              hello@astyltsvig.dk
            </a>
          </li>
          <li class="text-muted">{s.footer.location}</li>
        </ul>
      </div>
      <div>
        <h2 class="eyebrow">{s.footer.businessHeading}</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem] text-muted">
          <li>{s.footer.owner}</li>
          <li>{s.footer.cvr}</li>
          <li>{s.footer.founded}</li>
        </ul>
      </div>
      <div>
        <h2 class="eyebrow">{s.footer.linksHeading}</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem]">
          <li>
            <a href="https://github.com/astyltsvig" rel="me noopener" class="hover:text-accent transition-colors duration-150">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/astyltsvig/" rel="me noopener" class="hover:text-accent transition-colors duration-150">
              LinkedIn
            </a>
          </li>
          <li>
            <a href={routes.contact[lang]} class="hover:text-accent transition-colors duration-150">
              {s.nav.contact}
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-muted">
      <span>© {year} AStyltsvig Consulting</span>
      <span>Astro · Cloudflare Pages</span>
    </div>
  </div>
</footer>
