---
import { t, routes, type Lang } from '~/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t(lang);

const email = 'hello@astyltsvig.dk';
const github = 'https://github.com/astyltsvig';
const linkedin = 'https://www.linkedin.com/in/astyltsvig/';
const isEn = lang === 'en';
---
<footer class="footer-band">
  <div class="max-w-6xl mx-auto px-6 md:px-10 pt-16 md:pt-20 pb-10">

    <!-- Built-in CTA -->
    <div class="md:flex items-end justify-between gap-10">
      <div>
        <p class="font-[var(--font-mono)] text-[10px] uppercase tracking-[0.25em] text-[var(--color-band-muted)]">
          {isEn ? 'Have a project in mind?' : 'Har du et projekt?'}
        </p>
        <a href={`mailto:${email}`} class="mail-link mt-3 block text-3xl md:text-5xl font-bold tracking-tight text-[var(--color-band-text)]">
          {email}
        </a>
        <p class="mt-4 max-w-[52ch] text-sm text-[var(--color-band-muted)] leading-relaxed">
          {isEn
            ? "Send a short description of the project — I'll reply within two business days."
            : 'Send en kort beskrivelse af opgaven — jeg svarer inden for to hverdage.'}
        </p>
      </div>
      <div class="mt-8 md:mt-0 flex-none">
        <a href={routes.contact[lang]} class="btn-shimmer btn-primary">
          {d.cta.writeToMe}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- Columns -->
    <div class="mt-14 pt-10 border-t border-white/10 grid gap-8 sm:grid-cols-3 text-sm">
      <div>
        <p class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-band-muted)] font-[var(--font-mono)]">{d.footer.contact}</p>
        <ul class="mt-3 space-y-1.5 text-[var(--color-band-text)]">
          <li><a href={`mailto:${email}`} class="footer-link">{email}</a></li>
          <li><a href={github} rel="me noopener" target="_blank" class="footer-link">GitHub ↗</a></li>
          <li><a href={linkedin} rel="me noopener" target="_blank" class="footer-link">LinkedIn ↗</a></li>
        </ul>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-band-muted)] font-[var(--font-mono)]">{d.footer.legal}</p>
        <ul class="mt-3 space-y-1.5 text-[var(--color-band-muted)]">
          <li>AStyltsvig Consulting</li>
          <li>CVR 36163771</li>
          <li>{isEn ? 'Copenhagen, Denmark' : 'København, Danmark'}</li>
        </ul>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-band-muted)] font-[var(--font-mono)]">{d.languageSwitch.label}</p>
        <div class="mt-3"><LanguageSwitcher lang={lang} /></div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-band-muted)]">
      <span>© {new Date().getFullYear()} AStyltsvig Consulting</span>
      <span class="font-[var(--font-mono)]">Built with Astro · Cloudflare Pages</span>
    </div>
  </div>
</footer>

<style>
  .footer-band {
    background: var(--color-band);
    color: var(--color-band-text);
  }
  /* Base layer sets li to the page ink; re-inherit from the list inside the dark band */
  .footer-band :global(li) {
    color: inherit;
  }
  .mail-link:hover { color: var(--color-accent); }
  [data-theme="dark"] .mail-link:hover { color: var(--color-accent); }
  .footer-link:hover { color: var(--color-accent); }
  /* Language switcher renders with page-theme tokens; remap for the dark band */
  .footer-band :global(a[hreflang]) {
    border-color: rgba(255, 255, 255, 0.18);
    color: var(--color-band-muted);
  }
  .footer-band :global(a[hreflang]:hover) {
    border-color: var(--color-accent);
    color: var(--color-band-text);
  }
</style>
