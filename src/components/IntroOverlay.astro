---
// One-time entrance intro, played on an inverted ink curtain for maximum
// contrast against the paper-light site: the A-mark draws itself, the name
// rises hugely through a baseline mask, then a double curtain lifts —
// spruce green chasing ink — while the page plays its own entrance.
// Plays once per browser session; skipped for reduced-motion and no-JS.
const chars = [...'AStyltsvig'];
---
<div id="intro" class="intro-overlay" aria-hidden="true">
  <div class="intro-curtain intro-curtain-green"></div>
  <div class="intro-curtain intro-curtain-ink">
    <div class="intro-inner">
      <svg viewBox="0 0 48 48" class="intro-mark" fill="none" aria-hidden="true">
        <circle class="intro-stroke" cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5" />
        <path class="intro-stroke intro-stroke-a" d="M13 35 L22 13 L26 13 L35 35" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <path class="intro-stroke intro-stroke-bar" d="M17 27 L31 27" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        <circle class="intro-dot" cx="40" cy="40" r="2" stroke="none" />
      </svg>
      <p class="intro-name" aria-hidden="true">
        {chars.map((ch, i) => <span class="intro-char" style={`--i:${i}`}>{ch}</span>)}
      </p>
      <p class="intro-kicker">Consulting · København</p>
      <div class="intro-line"></div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    try {
      const el = document.getElementById('intro');
      if (!el) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || sessionStorage.getItem('introSeen')) {
        el.remove();
        return;
      }
      sessionStorage.setItem('introSeen', '1');
      document.documentElement.classList.add('intro-play');
      document.body.style.overflow = 'hidden';
      // The page's own entrance starts as the green curtain begins to lift,
      // so the reveal happens underneath the moving band.
      window.setTimeout(() => {
        document.dispatchEvent(new CustomEvent('intro:done'));
      }, 3450);
      window.setTimeout(() => {
        el.remove();
        document.body.style.overflow = '';
        document.documentElement.classList.remove('intro-play');
      }, 4400);
    } catch (_) {
      document.getElementById('intro')?.remove();
    }
  })();
</script>

<noscript>
  <style>
    .intro-overlay { display: none !important; }
  </style>
</noscript>

<style>
  /* Hidden unless the gate script opts in — no-JS and repeat visitors never see it. */
  .intro-overlay {
    display: none;
  }

  :global(html.intro-play) .intro-overlay {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .intro-curtain {
    position: absolute;
    inset: 0;
  }

  .intro-curtain-green {
    background: var(--color-accent);
    animation: intro-exit 0.85s cubic-bezier(0.76, 0, 0.24, 1) 3.45s forwards;
  }

  .intro-curtain-ink {
    background: var(--color-ink);
    color: var(--color-paper);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: intro-exit 0.85s cubic-bezier(0.76, 0, 0.24, 1) 3.15s forwards;
  }

  .intro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 3vh, 2rem);
    padding: 1.5rem;
    text-align: center;
  }

  .intro-mark {
    width: clamp(3.5rem, 8vw, 5.5rem);
    height: clamp(3.5rem, 8vw, 5.5rem);
  }

  .intro-stroke {
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    animation: intro-draw 1.1s var(--ease-out) forwards;
  }

  .intro-stroke-a { animation-delay: 0.25s; }
  .intro-stroke-bar { animation-delay: 0.6s; }

  .intro-dot {
    fill: var(--color-accent);
    opacity: 0;
    animation: intro-fade 0.35s ease-out 1.1s forwards;
  }

  /* The baseline mask the letters rise through. */
  .intro-name {
    overflow: hidden;
    padding-inline: 0.05em;
    font-size: clamp(3rem, 11vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .intro-char {
    display: inline-block;
    transform: translateY(120%) rotate(4deg);
    animation: intro-char 0.8s var(--ease-out) forwards;
    animation-delay: calc(0.55s + var(--i) * 0.07s);
  }

  .intro-kicker {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.2vw, 0.875rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-paper) 55%, transparent);
    opacity: 0;
    animation: intro-fade 0.6s ease-out 2s forwards;
  }

  .intro-line {
    width: 0;
    height: 2px;
    background: var(--color-accent);
    animation: intro-grow 0.8s var(--ease-out) 2.2s forwards;
  }

  @keyframes intro-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes intro-char {
    to { transform: none; }
  }

  @keyframes intro-fade {
    to { opacity: 1; }
  }

  @keyframes intro-grow {
    to { width: min(24rem, 70vw); }
  }

  @keyframes intro-exit {
    to { transform: translateY(-100%); }
  }
</style>
