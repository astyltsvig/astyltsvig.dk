---
interface Props {
  href: string;
  variant?: 'solid' | 'link';
}

const { href, variant = 'solid' } = Astro.props;
---
{variant === 'solid' ? (
  <a
    href={href}
    class="inline-block bg-ink text-paper px-6 py-3 text-[0.9375rem] font-medium hover:bg-accent transition-colors duration-150"
  >
    <slot />
  </a>
) : (
  <a
    href={href}
    class="inline-block text-[0.9375rem] font-medium text-accent underline underline-offset-4 decoration-1 hover:text-accent-strong transition-colors duration-150"
  >
    <slot />
  </a>
)}
