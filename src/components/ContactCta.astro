---
import type { Lang } from '~/i18n/routes';
import { shared } from '~/copy/shared';

interface Props {
  lang: Lang;
  heading?: string;
}

const { lang, heading } = Astro.props;
const s = shared[lang];
---
{/* The dark finale: every page ends on the same ink/green contrast the intro opens with. */}
<section class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-20 md:py-28">
    <p class="eyebrow !text-paper/50 reveal">{s.cta.eyebrow}</p>
    <h2 class="mt-4 max-w-[24ch] text-[clamp(2rem,5vw,3.5rem)] reveal" style="--reveal-delay: 80ms">{heading ?? s.cta.heading}</h2>
    <p class="mt-6 max-w-[56ch] text-paper/70 reveal" style="--reveal-delay: 160ms">{s.cta.body}</p>
    <a
      href={`mailto:${s.cta.email}`}
      class="mt-10 inline-block text-[clamp(1.5rem,4vw,2.5rem)] font-semibold tracking-tight text-accent-soft underline underline-offset-8 decoration-1 hover:text-paper transition-colors duration-150 reveal"
      style="--reveal-delay: 240ms"
    >
      {s.cta.email}
    </a>
  </div>
</section>
