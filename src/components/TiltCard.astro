---
interface Props {
  class?: string;
  href?: string;
  maxTilt?: number; // kept for call-site compatibility; no longer used
}

const { class: cls = '', href } = Astro.props;
const Tag = href ? 'a' : 'div';
const commonProps = {
  class: `card ${href ? 'card-link' : ''} glass ${cls}`,
  ...(href ? { href } : {}),
};
---
<Tag {...commonProps}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: block;
    padding: 1.75rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
</style>
