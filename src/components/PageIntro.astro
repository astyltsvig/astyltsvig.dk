---
interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { eyebrow, heading, lede } = Astro.props;
---
<section class="mx-auto max-w-6xl px-6 md:px-10 pt-16 md:pt-24 pb-12 md:pb-16">
  {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
  <h1 class="mt-4 max-w-[22ch] text-[clamp(2.25rem,5.5vw,4rem)] reveal" style="--reveal-delay: 80ms">{heading}</h1>
  {lede && <p class="mt-6 max-w-[58ch] text-lg text-muted reveal" style="--reveal-delay: 160ms">{lede}</p>}
  <slot />
</section>
