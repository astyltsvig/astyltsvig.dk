---
import { routes, type Lang } from '~/i18n/routes';
import { shared } from '~/copy/shared';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = shared[lang];
---
<a
  href={routes.home[lang]}
  class="flex items-center gap-3 text-ink hover:text-accent transition-colors duration-150"
  aria-label={s.logo.label}
>
  {/* Same A-mark as public/logo.svg and the email signature, drawn in currentColor. */}
  <svg viewBox="0 0 48 48" class="h-8 w-8 shrink-0" aria-hidden="true" fill="none">
    <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5" />
    <path d="M13 35 L22 13 L26 13 L35 35" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M17 27 L31 27" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
    <circle cx="40" cy="40" r="2" fill="currentColor" stroke="none" />
  </svg>
  <span class="flex flex-col justify-center leading-none">
    <span class="text-[0.9375rem] font-semibold tracking-tight">AStyltsvig</span>
    <span class="mt-1 font-mono text-[0.5625rem] uppercase tracking-[0.22em] text-muted">Consulting</span>
  </span>
</a>
