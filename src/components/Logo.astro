---
import { type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
  size?: 'sm' | 'lg';
  href?: string;
}

const { lang, size = 'sm', href = lang === 'en' ? '/en/' : '/' } = Astro.props;
const big = size === 'lg';
---
<a href={href} class="logo inline-flex items-center gap-3" aria-label="AStyltsvig Consulting">
  <span class="logo-mark" class:list={[big ? 'h-14 w-14' : 'h-9 w-9']} aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="24" cy="24" r="22" stroke="var(--color-accent)" stroke-width="1.5"/>
      <path d="M13 35 L22 13 L26 13 L35 35" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <path d="M17 27 L31 27" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round"/>
      <circle cx="40" cy="40" r="2" fill="var(--color-accent)"/>
    </svg>
  </span>
  <span class="flex flex-col leading-none">
    <span class:list={['font-[var(--font-display)] tracking-tight', big ? 'text-3xl' : 'text-xl']}>
      AStyltsvig
    </span>
    <span class:list={['font-[var(--font-mono)] uppercase tracking-[0.18em] text-[var(--color-muted)]', big ? 'text-[10px] mt-1.5' : 'text-[9px] mt-0.5']}>
      Consulting
    </span>
  </span>
</a>

<style>
  .logo { text-decoration: none; color: inherit; }
  .logo:hover { color: inherit; }
  .logo-mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
