---
import Logo from '~/components/Logo.astro';
import { routes, type AltPaths, type Lang, type RouteKey } from '~/i18n/routes';
import { shared } from '~/copy/shared';

interface Props {
  lang: Lang;
  altPaths?: AltPaths;
}

const { lang, altPaths } = Astro.props;
const s = shared[lang];

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'services', label: s.nav.services },
  { key: 'work', label: s.nav.work },
  { key: 'about', label: s.nav.about },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (key: RouteKey) => {
  const target = routes[key][lang].replace(/\/+$/, '') || '/';
  return currentPath === target || (target !== '/' && currentPath.startsWith(`${target}/`));
};

const switchTarget: Lang = lang === 'da' ? 'en' : 'da';
const switchUrl = altPaths?.[switchTarget];
const switchLabel = switchTarget.toUpperCase();
const switchName = switchTarget === 'da' ? s.languageSwitch.da : s.languageSwitch.en;
const contactActive = isActive('contact');
---
<header class="border-b border-line">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-3 sm:py-4 flex flex-wrap items-center gap-x-8 gap-y-1">
    <Logo lang={lang} />

    <nav class="order-3 w-full sm:order-none sm:w-auto sm:ml-auto" aria-label={lang === 'da' ? 'Hovedmenu' : 'Main menu'}>
      <ul class="-mx-2 sm:mx-0 flex items-center gap-1 sm:gap-5 md:gap-7">
        {navItems.map(item => (
          <li>
            <a
              href={routes[item.key][lang]}
              aria-current={isActive(item.key) ? 'page' : undefined}
              class:list={[
                'inline-block px-2 py-3 sm:px-0 sm:py-1 text-base sm:text-[0.9375rem] transition-colors duration-150 hover:text-accent',
                isActive(item.key)
                  ? 'text-accent underline underline-offset-8 decoration-1'
                  : 'text-ink link-sweep',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto sm:ml-0 flex items-center gap-4 sm:gap-5">
      {switchUrl && (
        <a
          href={switchUrl}
          class="inline-block px-1 py-3 -my-3 sm:py-1 sm:my-0 font-mono text-xs uppercase tracking-[0.14em] text-muted hover:text-accent transition-colors duration-150"
          aria-label={`${s.languageSwitch.label}: ${switchName}`}
          title={switchName}
          rel="alternate"
          hreflang={switchTarget}
        >
          {switchLabel}
        </a>
      )}
      <a
        href={routes.contact[lang]}
        aria-current={contactActive ? 'page' : undefined}
        class:list={[
          'inline-block px-4 py-2 text-[0.9375rem] font-medium transition-colors duration-150',
          contactActive ? 'bg-accent text-paper' : 'bg-ink text-paper hover:bg-accent',
        ]}
      >
        {s.nav.contact}
      </a>
    </div>
  </div>
</header>
