---
import { t, routes, type Lang } from '~/i18n/utils';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t(lang);

const navItems = [
  { label: d.nav.about, href: routes.about[lang] },
  { label: d.nav.services, href: routes.services[lang] },
  { label: d.nav.work, href: routes.work[lang] },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const contactActive = current === routes.contact[lang].replace(/\/+$/, '');
---
<header class="site-header sticky top-0 z-40 border-b border-[var(--color-rule)]">
  <div class="max-w-6xl mx-auto px-6 md:px-10 h-16 flex items-center justify-between gap-6">
    <Logo lang={lang} />
    <nav aria-label="Primary" class="hidden md:flex items-center gap-7">
      {navItems.map(item => {
        const isActive = current === item.href.replace(/\/+$/, '') || current.startsWith(item.href + '/');
        return (
          <a
            href={item.href}
            class:list={[
              'nav-link text-sm font-medium tracking-tight',
              isActive ? 'is-active' : 'text-[var(--color-muted)]',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} />
      <ThemeToggle lang={lang} />
      <a
        href={routes.contact[lang]}
        class="btn-shimmer btn-primary hidden sm:inline-flex !px-4 !py-2 text-sm"
        aria-current={contactActive ? 'page' : undefined}
      >
        {d.nav.contact}
      </a>
    </div>
  </div>
  <nav aria-label="Primary mobile" class="md:hidden border-t border-[var(--color-rule)]">
    <ul class="max-w-6xl mx-auto px-6 py-2.5 flex flex-wrap gap-x-6 gap-y-1">
      {[...navItems, { label: d.nav.contact, href: routes.contact[lang] }].map(item => {
        const isActive = current === item.href.replace(/\/+$/, '') || current.startsWith(item.href + '/');
        return (
          <li>
            <a
              href={item.href}
              class:list={['nav-link text-sm', isActive ? 'is-active' : 'text-[var(--color-muted)]']}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: color-mix(in oklab, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav-link {
    position: relative;
    padding-bottom: 2px;
  }
  .nav-link:hover { color: var(--color-text); }
  .nav-link.is-active { color: var(--color-text); }
  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-accent);
  }
</style>
