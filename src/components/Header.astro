---
import Logo from '~/components/Logo.astro';
import { routes, type AltPaths, type Lang, type RouteKey } from '~/i18n/routes';
import { shared } from '~/copy/shared';

interface Props {
  lang: Lang;
  altPaths?: AltPaths;
}

const { lang, altPaths } = Astro.props;
const s = shared[lang];

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'work', label: s.nav.work },
  { key: 'services', label: s.nav.services },
  { key: 'about', label: s.nav.about },
  { key: 'contact', label: s.nav.contact },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (key: RouteKey) => {
  const target = routes[key][lang].replace(/\/+$/, '') || '/';
  return currentPath === target || (target !== '/' && currentPath.startsWith(`${target}/`));
};

const switchTarget: Lang = lang === 'da' ? 'en' : 'da';
const switchUrl = altPaths?.[switchTarget];
const switchLabel = switchTarget === 'da' ? s.languageSwitch.da : s.languageSwitch.en;
---
<header class="border-b border-line">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-4 flex flex-wrap items-center gap-x-8 gap-y-3">
    <Logo lang={lang} />

    <nav class="order-3 w-full sm:order-none sm:w-auto sm:ml-auto" aria-label={lang === 'da' ? 'Hovedmenu' : 'Main menu'}>
      <ul class="flex items-center gap-5 md:gap-7">
        {navItems.map(item => (
          <li>
            <a
              href={routes[item.key][lang]}
              aria-current={isActive(item.key) ? 'page' : undefined}
              class:list={[
                'text-[0.9375rem] transition-colors duration-150 hover:text-accent',
                isActive(item.key)
                  ? 'text-accent underline underline-offset-8 decoration-1'
                  : 'text-ink link-sweep',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {switchUrl && (
      <a
        href={switchUrl}
        class="ml-auto sm:ml-0 font-mono text-xs uppercase tracking-[0.14em] text-muted hover:text-accent transition-colors duration-150"
        aria-label={s.languageSwitch.label}
        rel="alternate"
        hreflang={switchTarget}
      >
        {switchLabel}
      </a>
    )}
  </div>
</header>
