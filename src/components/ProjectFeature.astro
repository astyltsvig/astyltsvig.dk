---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Screenshot from '~/components/Screenshot.astro';
import { caseUrl, type Lang } from '~/i18n/routes';
import { shared } from '~/copy/shared';
import type { Case } from '~/lib/cases';
import mallardLogo from '~/assets/clients/mallard.png';
import cpofLogo from '~/assets/clients/care-pension-forsikring.png';
import securelifeLogo from '~/assets/clients/securelife.png';
import cuaLogo from '~/assets/clients/cycling-without-age.png';

interface Props {
  entry: Case;
  lang: Lang;
  index: number;
}

const { entry, lang, index } = Astro.props;
const s = shared[lang];
const { data } = entry;
const flipped = index % 2 === 1;

const metaParts = [s.categories[data.categoryKey], data.period, s.status[data.statusKey]];
const meta = metaParts
  .filter((part, i) => metaParts.findIndex(p => p.toLowerCase() === part.toLowerCase()) === i)
  .join(' · ');

/* Cases without a screenshot show the client's own logo on a dotted tile instead. */
const logos: Record<string, ImageMetadata> = {
  mallard: mallardLogo,
  cpof: cpofLogo,
  securelife: securelifeLogo,
  'cycling-without-age': cuaLogo,
};
const logo = logos[entry.slug];
---
<li class="border-t border-line first:border-t-0">
  <a
    href={caseUrl(lang, entry.slug)}
    class="group grid items-center gap-8 py-12 md:grid-cols-2 md:gap-14 md:py-16"
  >
    <div class:list={['reveal', flipped && 'md:order-2']}>
      {data.screenshot ? (
        <Screenshot
          file={data.screenshot}
          alt={data.screenshotAlt ?? data.client}
          widths={[480, 720, 1080]}
          sizes="(min-width: 768px) 520px, 100vw"
        />
      ) : (
        <div class="flex aspect-[16/10] items-center justify-center border border-line bg-surface logo-tile">
          {logo && (
            <Image
              src={logo}
              alt={`${data.client} logo`}
              height={120}
              densities={[1, 2]}
              format="webp"
              quality={85}
              class="max-h-[30%] w-auto max-w-[55%] transition-transform duration-300 group-hover:scale-105"
            />
          )}
        </div>
      )}
    </div>
    <div class="reveal" style="--reveal-delay: 120ms">
      <p class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{meta}</p>
      <h3 class="mt-3 text-2xl md:text-3xl font-semibold tracking-tight group-hover:text-accent transition-colors duration-150">
        {data.client}
      </h3>
      <p class="mt-4 max-w-[48ch] text-muted">{data.description}</p>
      <span class="mt-6 inline-flex items-center gap-2 font-medium text-accent">
        {s.caseNav.viewCase}
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
      </span>
    </div>
  </a>
</li>

<style>
  .logo-tile {
    background-image: radial-gradient(var(--color-line) 1px, transparent 1px);
    background-size: 18px 18px;
  }
</style>
