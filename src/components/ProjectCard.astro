---
import Screenshot from '~/components/Screenshot.astro';
import { caseUrl, type Lang } from '~/i18n/routes';
import { shared } from '~/copy/shared';
import type { Case } from '~/lib/cases';

interface Props {
  entry: Case;
  lang: Lang;
  revealDelay?: number;
}

const { entry, lang, revealDelay = 0 } = Astro.props;
const s = shared[lang];
const { data } = entry;

const metaParts = [s.categories[data.categoryKey], data.period, s.status[data.statusKey]];
const meta = metaParts
  .filter((part, i) => metaParts.findIndex(p => p.toLowerCase() === part.toLowerCase()) === i)
  .join(' · ');

/* Minimal line icons per category for cases without a screenshot. */
const icons: Record<string, string> = {
  platform:
    '<path d="M12 3 L21 8 L12 13 L3 8 Z" /><path d="M3 12.5 L12 17.5 L21 12.5" /><path d="M3 17 L12 22 L21 17" />',
  web:
    '<rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9 L21 9" /><circle cx="6.2" cy="6.5" r="0.4" /><circle cx="8.8" cy="6.5" r="0.4" /><circle cx="11.4" cy="6.5" r="0.4" />',
  ownProduct:
    '<path d="M12 2.5 L14.4 9.6 L21.5 12 L14.4 14.4 L12 21.5 L9.6 14.4 L2.5 12 L9.6 9.6 Z" />',
  operations:
    '<path d="M12 3 L20 6 V11 C20 16.5 16.6 20 12 21.5 C7.4 20 4 16.5 4 11 V6 Z" /><path d="M8.8 12 L11 14.2 L15.2 9.8" />',
};
---
<li class="reveal" style={`--reveal-delay: ${revealDelay}ms`}>
  <a
    href={caseUrl(lang, entry.slug)}
    class="group flex h-full flex-col border border-line bg-surface transition-all duration-200 hover:border-accent hover:-translate-y-1"
  >
    {data.screenshot ? (
      <Screenshot
        file={data.screenshot}
        alt={data.screenshotAlt ?? data.client}
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 540px, 100vw"
        class="!border-0 border-b !border-line"
      />
    ) : (
      <div class="flex aspect-[16/10] items-center justify-center border-b border-line bg-paper">
        <svg
          viewBox="0 0 24 24"
          class="h-16 w-16 text-accent transition-transform duration-300 group-hover:scale-110"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons[data.categoryKey] ?? icons.platform}
        />
      </div>
    )}
    <div class="flex flex-1 flex-col p-6">
      <p class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-muted">{meta}</p>
      <h3 class="mt-2 text-xl font-semibold tracking-tight group-hover:text-accent transition-colors duration-150">
        {data.client}
      </h3>
      <p class="mt-2 text-[0.9375rem] text-muted">{data.description}</p>
      <span
        aria-hidden="true"
        class="mt-auto pt-4 self-end text-muted transition-all duration-200 group-hover:text-accent group-hover:translate-x-1"
      >
        →
      </span>
    </div>
  </a>
</li>
